{"id":1630,"date":"2020-12-29T10:04:40","date_gmt":"2020-12-29T08:04:40","guid":{"rendered":"https:\/\/lvriathens.com\/?page_id=1630"},"modified":"2022-12-15T11:48:49","modified_gmt":"2022-12-15T09:48:49","slug":"anazoogonisi-kolpou","status":"publish","type":"page","link":"https:\/\/lvriathens.com\/anazoogonisi-kolpou\/","title":{"rendered":"\u0391\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5"},"content":{"rendered":"<p>[vc_row][vc_column][vc_single_image image=&#8221;1658&#8243; img_size=&#8221;full&#8221; alignment=&#8221;center&#8221;][\/vc_column][\/vc_row][vc_row][vc_column][vc_column_text]<\/p>\n<h2><\/h2>\n<h2>\u0391\u03c4\u03c1\u03bf\u03c6\u03af\u03b1 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5 &#8211; \u03a4\u03b9 \u0395\u03af\u03bd\u03b1\u03b9<\/h2>\n<p>\u03a4\u03bf \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03af\u03c3\u03c9\u03c2 \u03c4\u03bf \u03c0\u03b9\u03bf \u03c3\u03cd\u03bc\u03c0\u03bb\u03bf\u03ba\u03bf \u03cc\u03c1\u03b3\u03b1\u03bd\u03bf \u03c4\u03bf\u03c5 \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03b5\u03af\u03bf\u03c5 \u03bf\u03c1\u03b3\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd \u03ba\u03b1\u03b8\u03ce\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c4\u03b1\u03c5\u03c4\u03cc\u03c7\u03c1\u03bf\u03bd\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1, \u03cc\u03c7\u03b9 \u03bc\u03cc\u03bd\u03bf \u03c4\u03bf\u03c5 \u03b3\u03b5\u03bd\u03bd\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5 \u03bf\u03c5\u03c1\u03bf\u03c0\u03bf\u03b9\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd \u03cc\u03c0\u03c9\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5 \u03c0\u03b5\u03c0\u03c4\u03b9\u03ba\u03bf\u03cd \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2.<\/p>\n<p>\u0391\u03bd\u03b1\u03bb\u03c5\u03c4\u03b9\u03ba\u03ac, \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03c3\u03b8\u03b9\u03b1 \u03b5\u03c0\u03b9\u03c6\u03ac\u03bd\u03b5\u03b9\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03b5\u03bd\u03c4\u03bf\u03c0\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03b7 \u03bf\u03c5\u03c1\u03bf\u03b4\u03cc\u03c7\u03bf\u03c2 \u03ba\u03cd\u03c3\u03c4\u03b7 \u03ba\u03b1\u03b9 \u03b7 \u03bf\u03c5\u03c1\u03ae\u03b8\u03c1\u03b1 ,\u03c3\u03c4\u03bf\u03bd \u03c0\u03c5\u03b8\u03bc\u03ad\u03bd\u03b1 \u03c4\u03bf\u03c5 \u03b2\u03c1\u03af\u03c3\u03ba\u03b5\u03c4\u03b1\u03b9 \u03bf \u03c4\u03c1\u03ac\u03c7\u03b7\u03bb\u03bf\u03c2 \u03c4\u03b7\u03c2 \u03bc\u03ae\u03c4\u03c1\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03bf \u03bf\u03c0\u03af\u03c3\u03b8\u03b9\u03bf \u03c4\u03bc\u03ae\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03b7 \u03ba\u03b1\u03c4\u03b9\u03bf\u03cd\u03c3\u03b1 \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03b5\u03bd\u03c4\u03ad\u03c1\u03bf\u03c5. \u03a6\u03c5\u03bb\u03bf\u03b3\u03b5\u03bd\u03b5\u03c4\u03b9\u03ba\u03ac \u03b4\u03b5 \u03c4\u03bf \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf \u03ba\u03bf\u03bc\u03bc\u03ac\u03c4\u03b9 \u03c4\u03bf\u03c5 (\u03c0\u03b5\u03c1\u03af\u03c0\u03bf\u03c5 \u03c4\u03b1 9\/10) \u03c0\u03c1\u03bf\u03ad\u03c1\u03c7\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03bf \u03b5\u03bc\u03b2\u03c1\u03c5\u03ca\u03ba\u03cc \u03bc\u03b5\u03c3\u03cc\u03b4\u03b5\u03c1\u03bc\u03b1 ,\u03b5\u03bd\u03ce \u03c4\u03bf \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf \u03c4\u03bc\u03ae\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03cc\u03c0\u03c9\u03c2 \u03ba\u03b1\u03b9 \u03b7 \u03b5\u03af\u03c3\u03bf\u03b4\u03bf\u03c2 (\u03c0\u03c1\u03cc\u03b4\u03bf\u03bc\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03bf\u03bb\u03b5\u03bf\u03cd \u03bc\u03b1\u03b6\u03b9 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03c0\u03b1\u03c1\u03b8\u03b5\u03bd\u03b9\u03ba\u03cc \u03c5\u03bc\u03ad\u03bd\u03b1) \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03bc\u03b9\u03ba\u03c1\u03ac \u03ba\u03b1\u03b9 \u03bc\u03b5\u03b3\u03ac\u03bb\u03b1 \u03c7\u03b5\u03af\u03bb\u03b7, \u03c0\u03c1\u03bf\u03ad\u03c1\u03c7\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03bf \u03b5\u03bc\u03b2\u03c1\u03c5\u03b9\u03ba\u03cc \u03b5\u03be\u03ce\u03b4\u03b5\u03c1\u03bc\u03b1.<\/p>\n<p>\u0397 \u03c3\u03b7\u03bc\u03b1\u03c3\u03af\u03b1 \u03b1\u03c5\u03c4\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03ad\u03bb\u03b5\u03c5\u03c3\u03b7 \u03ad\u03c7\u03b5\u03b9 \u03c4\u03b5\u03c1\u03ac\u03c3\u03c4\u03b9\u03b1 \u03c3\u03b7\u03bc\u03b1\u03c3\u03af\u03b1 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03cc\u03c0\u03c9\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b9\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03c5\u03c6\u03af\u03c3\u03c4\u03b1\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c0\u03ac\u03c1\u03bf\u03b4\u03bf \u03c4\u03bf\u03c5 \u03c7\u03c1\u03cc\u03bd\u03bf\u03c5 \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae\u03c2 \u03c4\u03c9\u03bd \u03bf\u03c1\u03bc\u03bf\u03bd\u03ce\u03bd \u03c3\u03c4\u03b7\u03bd \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7, \u03b5\u03af\u03c4\u03b5 \u03b1\u03c5\u03c4\u03ae \u03c3\u03c5\u03bc\u03b2\u03b1\u03af\u03bd\u03b5\u03b9 \u03c6\u03b1\u03c1\u03bc\u03b1\u03ba\u03bf\u03b3\u03b5\u03bd\u03ce\u03c2 \u03c3\u03b5 \u03c0\u03b1\u03b8\u03ae\u03c3\u03b5\u03b9\u03c2 \u03ae \u03c6\u03c5\u03c3\u03b9\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03ac \u03bc\u03b5 \u03c4\u03b7\u03bd \u03b7\u03bb\u03b9\u03ba\u03af\u03b1.<\/p>\n<p>\u03a0\u03b9\u03bf \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03b1 \u03c4\u03b1 \u03ba\u03cd\u03c4\u03c4\u03b1\u03c1\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5, \u03c0\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03bb\u03b1\u03ba\u03ce\u03b4\u03b7 \u03b5\u03be\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ac \u03ba\u03b1\u03b9 \u03ba\u03c5\u03bb\u03b9\u03bd\u03b4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03bd \u03c0\u03c5\u03b8\u03bc\u03ad\u03bd\u03b1 \u03c4\u03bf\u03c5 ,\u03bf\u03c6\u03b5\u03af\u03bb\u03bf\u03c5\u03bd \u03bd\u03b1 \u03ad\u03c7\u03bf\u03c5\u03bd \u03c3\u03c7\u03b5\u03c4\u03b9\u03ba\u03ac \u03cc\u03be\u03b9\u03bd\u03bf PH (3,5-5,2) \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03bf\u03bc\u03b1\u03bb\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03c7\u03c9\u03c1\u03af\u03c2 \u03b5\u03bd\u03bf\u03c7\u03bb\u03ae\u03c3\u03b5\u03b9\u03c2 \u03ba\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b5\u03c0\u03af\u03c4\u03b5\u03c5\u03be\u03b7 \u03c6\u03c5\u03c3\u03b9\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03ae\u03c2 \u03bc\u03b9\u03ba\u03c1\u03bf\u03b2\u03b9\u03b1\u03ba\u03ae\u03c2 \u03c7\u03bb\u03c9\u03c1\u03af\u03b4\u03b1\u03c2.\u03a4\u03bf \u03b2\u03b1\u03c3\u03b9\u03ba\u03cc \u03c4\u03c1\u03bf\u03c6\u03b9\u03ba\u03cc \u03b5\u03c1\u03ad\u03b8\u03b9\u03c3\u03bc\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03bf\u03bc\u03b1\u03bb\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03c5\u03c8\u03b7\u03bb\u03ae \u03bf\u03b9\u03c3\u03c4\u03c1\u03bf\u03b3\u03bf\u03bd\u03b9\u03ba\u03ae \u03b4\u03c1\u03ac\u03c3\u03b7 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bc\u03b2\u03b1\u03af\u03bd\u03b5\u03b9 \u03cc\u03c4\u03b1\u03bd \u03b7 \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b1 \u03ad\u03c7\u03b5\u03b9 \u03ba\u03b1\u03bd\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03b5\u03c1\u03af\u03bf\u03b4\u03bf \u03ba\u03b1\u03b9 \u03c0\u03b1\u03c1\u03ac\u03b3\u03b5\u03b9 \u03bf\u03b9\u03c3\u03c4\u03c1\u03b1\u03b4\u03b9\u03cc\u03bb\u03b7 \u03952.<\/p>\n<h3>\u039a\u03bf\u03bb\u03c0\u03b9\u03ba\u03ae\u03c2 \u0391\u03c4\u03c1\u03bf\u03c6\u03af\u03b1 &#8211; \u03a3\u03c4\u03ac\u03b4\u03b9\u03b1<\/h3>\n<p>\u0391\u03bd\u03c4\u03af\u03b8\u03b5\u03c4\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7 ,\u03c0\u03bf\u03c5 \u03c3\u03c4\u03b1\u03bc\u03b1\u03c4\u03ac\u03b5\u03b9 \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf \u03c0\u03bf\u03c3\u03bf\u03c3\u03c4\u03cc \u03b7 \u03bf\u03c1\u03bc\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae, \u03cc\u03c0\u03c9\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b9\u03b1\u03c4\u03c1\u03b9\u03ba\u03ae \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7 \u03cc\u03c0\u03bf\u03c5 \u03bc\u03b5 \u03c6\u03ac\u03c1\u03bc\u03b1\u03ba\u03b1 \u03b7 \u03c7\u03b5\u03b9\u03c1\u03bf\u03c5\u03c1\u03b3\u03b9\u03ba\u03ad\u03c2 \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c4\u03b1\u03bc\u03b1\u03c4\u03ac\u03b5\u03b9 \u03b7 \u03c0\u03b5\u03c1\u03af\u03bf\u03b4\u03bf\u03c2 (\u03c0\u03c7 \u03c3\u03b5 \u03ba\u03b1\u03c1\u03ba\u03af\u03bd\u03bf \u03bc\u03b1\u03c3\u03c4\u03bf\u03cd, \u03c9\u03bf\u03b8\u03b7\u03ba\u03ce\u03bd, \u03c4\u03c1\u03b1\u03c7\u03ae\u03bb\u03bf\u03c5, \u03bb\u03b5\u03bc\u03c6\u03ce\u03bc\u03b1\u03c4\u03b1 \u03b7 PIF premature ovarian failure -\u03c0\u03c1\u03cc\u03c9\u03c1\u03b7 \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7) \u03c0\u03b1\u03c1\u03b1\u03c4\u03b7\u03c1\u03bf\u03cd\u03bc\u03b5 \u03b4\u03b9\u03b1\u03c4\u03b1\u03c1\u03b1\u03c7\u03ae \u03c3\u03c4\u03b9\u03c2 \u03b4\u03bf\u03bc\u03ad\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5, \u03ac\u03bb\u03bb\u03bf\u03c4\u03b5 \u03c3\u03c4\u03b1\u03b4\u03b9\u03b1\u03ba\u03ae \u03ba\u03b1\u03b9 \u03ac\u03bb\u03bb\u03bf\u03c4\u03b5 \u03c1\u03b1\u03b3\u03b4\u03b1\u03af\u03b1. \u039f\u03b9 \u03c4\u03c1\u03bf\u03c0\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03b9\u03c2 \u03b1\u03c5\u03c4\u03ad\u03c2, \u03c0\u03bf\u03c5 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03bf\u03cd\u03bd \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03b5\u03bd\u03bf\u03c7\u03bb\u03ae\u03c3\u03b5\u03b9\u03c2 \u03ae \u03c4\u03b9\u03c2 \u03c0\u03b1\u03b8\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b9\u03c2 \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 ,\u03ad\u03c7\u03bf\u03c5\u03bd \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03bd\u03b1 \u03ba\u03ac\u03bd\u03bf\u03c5\u03bd \u03bc\u03b5 \u03c4\u03b9\u03c2 \u03bf\u03c1\u03bc\u03bf\u03bd\u03b9\u03ba\u03ad\u03c2 \u03b5\u03c0\u03b9\u03c0\u03bb\u03bf\u03ba\u03ad\u03c2 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03ba\u03b1\u03bb\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ac \u03b5\u03c0\u03b9\u03b8\u03ae\u03bb\u03b9\u03b1.<\/p>\n<p>\u0391\u03c1\u03c7\u03b9\u03ba\u03ac \u03bf \u03ba\u03cc\u03bb\u03c0\u03bf\u03c2 \u03c7\u03ac\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03b9\u03ba\u03b1\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf\u03c5 \u03bc\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03bd\u03b1 \u03c3\u03c4\u03b5\u03b3\u03bd\u03ce\u03bd\u03b5\u03b9, \u03bd\u03b1 \u03bb\u03b5\u03c0\u03c4\u03b1\u03af\u03bd\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03bb\u03cc\u03b3\u03c9 \u03c4\u03b7\u03c2 \u03c0\u03c4\u03ce\u03c3\u03b7\u03c2 \u03c4\u03c9\u03bd \u03bf\u03b9\u03c3\u03c4\u03c1\u03bf\u03b3\u03cc\u03bd\u03c9\u03bd \u03bd\u03b1 \u03c7\u03b1\u03bb\u03ac\u03b5\u03b9 \u03b7 \u03c7\u03bb\u03c9\u03c1\u03af\u03b4\u03b1 \u03c4\u03bf\u03c5 \u03c4\u03b1\u03c5\u03c4\u03cc\u03c7\u03c1\u03bf\u03bd\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03c4\u03bf\u03c5 PH \u03c4\u03bf\u03c5 (\u03b1\u03bb\u03ba\u03b1\u03bb\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 6-7 ). \u03a3\u03c5\u03c7\u03bd\u03ac \u03c0\u03c1\u03bf\u03ba\u03b1\u03bb\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03c6\u03bb\u03b5\u03b3\u03bc\u03bf\u03bd\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03b4\u03c5\u03c3\u03ac\u03c1\u03b5\u03c3\u03c4\u03b5\u03c2 \u03bf\u03c3\u03bc\u03ad\u03c2 ,\u03cc\u03c0\u03c9\u03c2 \u03ba\u03b1\u03b9 \u03b7 \u03ad\u03bd\u03b1\u03c1\u03be\u03b7 \u03c4\u03bf\u03c5 \u03b1\u03b9\u03c3\u03b8\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03b4\u03c5\u03c3\u03ba\u03bf\u03bb\u03af\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03af\u03c4\u03b5\u03c5\u03be\u03b7 \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ae\u03c2 \u03b5\u03c0\u03b1\u03c6\u03ae\u03c2 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03bc\u03b5\u03b9\u03c9\u03bc\u03ad\u03bd\u03b7 \u03b5\u03c0\u03b9\u03b8\u03c5\u03bc\u03af\u03b1 (\u03c0\u03c4\u03ce\u03c3\u03b7 libido).<\/p>\n<p>\u03a3\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1, \u03c3\u03c4\u03b1\u03b4\u03b9\u03b1\u03ba\u03ac, \u03ad\u03c7\u03bf\u03c5\u03bc\u03b5 \u03b1\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b5\u03bd\u03c5\u03b4\u03ac\u03c4\u03c9\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03bf\u03cd \u03b1\u03c5\u03bb\u03bf\u03cd \u03c0\u03bf\u03c5 \u03b1\u03c6\u03bf\u03c1\u03ac \u03c4\u03cc\u03c3\u03bf \u03c4\u03bf \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03cc \u03c4\u03bf\u03c5 ,\u03cc\u03c3\u03bf \u03ba\u03b1\u03b9 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03bf \u03c4\u03b7\u03bd \u03b5\u03af\u03c3\u03bf\u03b4\u03bf \u03c4\u03bf\u03c5, \u03bc\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03b7 \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03b1\u03c4\u03c1\u03bf\u03c6\u03af\u03b1 \u03bc\u03b5 \u03bb\u03ad\u03c0\u03c4\u03c5\u03bd\u03c3\u03b7 \u03c4\u03c9\u03bd \u03b9\u03c3\u03c4\u03ce\u03bd, \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b5\u03c0\u03ac\u03b3\u03b5\u03c4\u03b1\u03b9 \u03b4\u03c5\u03c3\u03c0\u03b1\u03c1\u03b5\u03c5\u03bd\u03af\u03b1 (\u03c0\u03cc\u03bd\u03bf \u03b4\u03b7\u03bb\u03b1\u03b4\u03ae \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf \u03c3\u03b5\u03be).<\/p>\n<p>\u03a4\u03ad\u03bb\u03bf\u03c2 \u03c3\u03b5 \u03c0\u03b9\u03bf \u03c0\u03c1\u03bf\u03c7\u03c9\u03c1\u03b7\u03bc\u03ad\u03bd\u03b1 \u03c3\u03c4\u03ac\u03b4\u03b9\u03b1 \u03b1\u03c4\u03c1\u03bf\u03c6\u03af\u03b1\u03c2 \u03c7\u03ac\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c4\u03b1 \u03b1\u03b3\u03b3\u03b5\u03af\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03bd\u03b5\u03c5\u03c1\u03af\u03b4\u03b9\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03bc\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03bd\u03b1 \u03bc\u03b5\u03b9\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c0\u03bf\u03bb\u03cd \u03b7 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1,\u03bd\u03b1 \u03c3\u03c4\u03b5\u03bd\u03b5\u03cd\u03b5\u03b9 \u03b7 \u03b5\u03af\u03c3\u03bf\u03b4\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ac \u03c4\u03bf\u03b9\u03c7\u03ce\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b5\u03c0\u03ad\u03c1\u03c7\u03b5\u03c4\u03b1\u03b9 \u03c4\u03bf \u03bf\u03c5\u03c1\u03bf\u03b3\u03b5\u03bd\u03bd\u03b7\u03c4\u03b9\u03ba\u03cc \u03c3\u03cd\u03bd\u03b4\u03c1\u03bf\u03bc\u03bf \u03c4\u03b7\u03c2 \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7\u03c2 GSM \u03c0\u03bf\u03c5 \u03c0\u03b5\u03c1\u03b9\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9 \u03bf\u03c5\u03c1\u03bf\u03bb\u03bf\u03b9\u03bc\u03ce\u03be\u03b5\u03b9\u03c2, \u03ad\u03bd\u03c4\u03bf\u03bd\u03b7 \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c5\u03c3\u03b1\u03bb\u03b3\u03af\u03b1, \u03b4\u03c5\u03c3\u03c0\u03b1\u03c1\u03b5\u03c5\u03bd\u03af\u03b1 \u03ba\u03b1\u03b9 \u03b3\u03b5\u03bd\u03b9\u03ba\u03ac \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03bc\u03b9\u03b1 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03b9\u03b4\u03b9\u03b1\u03af\u03c4\u03b5\u03c1\u03b1 \u03b5\u03bd\u03bf\u03c7\u03bb\u03b7\u03c4\u03b9\u03ba\u03ae, \u03b1\u03c6\u03bf\u03cd \u03b5\u03c0\u03b7\u03c1\u03b5\u03ac\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03ba\u03b1\u03b8\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03ad\u03c6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b6\u03c9\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c5\u03b3\u03b5\u03af\u03b1 \u03c4\u03c9\u03bd \u03b1\u03c3\u03b8\u03b5\u03bd\u03ce\u03bd.<\/p>\n<p>\u0397 \u03c6\u03b8\u03bf\u03c1\u03ac \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b7 \u03c0\u03c1\u03bf\u03b2\u03bb\u03b7\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c4\u03bf\u03c5 ,\u03c3\u03b1\u03c6\u03ce\u03c2 \u03c3\u03c5\u03bc\u03b2\u03b1\u03af\u03bd\u03b5\u03b9 \u03b5\u03bd\u03af\u03bf\u03c4\u03b5 \u03c3\u03b5 \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bc\u03b5 \u03ba\u03b1\u03bd\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03b5\u03c1\u03af\u03bf\u03b4\u03bf, \u03c3\u03c5\u03bd\u03ae\u03b8\u03c9\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b1 30-35 \u03ad\u03c4\u03b7 \u03b7\u03bb\u03b9\u03ba\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03b1\u03c1\u03ba\u03b5\u03c4\u03ac \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1 \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b1\u03c6\u03ce\u03bd, \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03c6\u03c5\u03c3\u03b9\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03bf\u03cd\u03c2 \u03c4\u03bf\u03ba\u03b5\u03c4\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03c7\u03c1\u03cc\u03bd\u03b9\u03b5\u03c2 \u03c6\u03bb\u03b5\u03b3\u03bc\u03bf\u03bd\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03c4\u03b9\u03b2\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03c1\u03ad\u03c6\u03bf\u03c5\u03bd \u03c4\u03b7 \u03c7\u03bb\u03c9\u03c1\u03af\u03b4\u03b1. \u03a0\u03b1\u03c1\u03bf\u03c5\u03c3\u03b9\u03ac\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03c0\u03c4\u03ce\u03c3\u03b5\u03b9\u03c2 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c3\u03c5\u03bd\u03b4\u03c5\u03b1\u03c3\u03bc\u03bf\u03af \u03b1\u03c0\u03cc \u03c0\u03b1\u03b8\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 \u03cc\u03c0\u03c9\u03c2 \u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03c6\u03ae, \u03b4\u03b9\u03b1\u03c4\u03b1\u03c1\u03b1\u03c7\u03ad\u03c2 \u03bf\u03cd\u03c1\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1 \u03bf\u03cd\u03c1\u03c9\u03bd, \u03c5\u03c0\u03b5\u03c1\u03b2\u03bf\u03bb\u03b9\u03ba\u03ac \u03c5\u03b3\u03c1\u03ac \u03ba\u03b1\u03b9 \u03b4\u03c5\u03c3\u03ac\u03c1\u03b5\u03c3\u03c4\u03b7 \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1 \u03bf\u03c3\u03bc\u03ae.<\/p>\n<h2>\u0391\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5 \u039c\u03b5 Laser<\/h2>\n<p><img loading=\"lazy\" class=\"aligncenter wp-image-1660\" src=\"https:\/\/lvriathens.com\/wp-content\/uploads\/2021\/03\/eikona2-300x179.png\" alt=\"\u0391\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5 \u03bc\u03b5 Laser\" width=\"500\" height=\"299\" srcset=\"https:\/\/lvriathens.com\/wp-content\/uploads\/2021\/03\/eikona2-300x179.png 300w, https:\/\/lvriathens.com\/wp-content\/uploads\/2021\/03\/eikona2-768x458.png 768w, https:\/\/lvriathens.com\/wp-content\/uploads\/2021\/03\/eikona2.png 1000w\" sizes=\"(max-width: 500px) 100vw, 500px\" \/>\u03a0\u03ac\u03bd\u03c9 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03c3\u03c4\u03b7\u03bd \u03bd\u03bf\u03c3\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b1\u03af\u03c4\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b1\u03c4\u03c1\u03bf\u03c6\u03af\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03b2\u03b1\u03c3\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bf\u03b9 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2 \u03b1\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03c0\u03bf\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03bf\u03bc\u03b1\u03bb\u03ae\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03b5\u03af\u03c4\u03b5 \u03bc\u03b5 \u03c4\u03b7 \u03c6\u03b8\u03bf\u03c1\u03ac \u03c4\u03bf\u03c5 \u03c7\u03c1\u03cc\u03bd\u03bf\u03c5 \u03ae \u03bc\u03b5 \u03c4\u03b7\u03bd \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7.<\/p>\n<h2>\u0391\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5 \u039c\u03b5 Laser &#8211; \u0394\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1<\/h2>\n<p>\u0397 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03bc\u03b5 \u03c7\u03c1\u03ae\u03c3\u03b7 laser \/ Renovalaser \u03ad\u03c7\u03b5\u03b9 \u03c4\u03b7 \u03b4\u03c5\u03bd\u03b1\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1, \u03bc\u03b5 2 \u03ae 3 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03b5\u03c2, \u03b1\u03bd\u03ce\u03b4\u03c5\u03bd\u03b1, \u03c3\u03c4\u03bf \u03b9\u03b1\u03c4\u03c1\u03b5\u03af\u03bf, \u03b4\u03b9\u03ac\u03c1\u03ba\u03b5\u03b9\u03b1\u03c2 15 \u03bb\u03b5\u03c0\u03c4\u03ce\u03bd \u03b7 \u03ba\u03b1\u03b8\u03b5\u03bc\u03af\u03b1, \u03bd\u03b1 \u03b1\u03c0\u03bf\u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03c3\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5, \u03b2\u03b5\u03bb\u03c4\u03b9\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7\u03bd \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03b1\u03c4\u03c1\u03bf\u03c6\u03af\u03b1, \u03c4\u03b7\u03bd \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03b5\u03bd\u03c5\u03b4\u03ac\u03c4\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5, \u03b2\u03bf\u03b7\u03b8\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03b9\u03c2 \u03bb\u03bf\u03b9\u03bc\u03ce\u03be\u03b5\u03b9\u03c2 \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03ce\u03b4\u03c5\u03bd\u03b7 \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae \u03c4\u03c9\u03bd \u03b1\u03c3\u03b8\u03b5\u03bd\u03ce\u03bd.<\/p>\n<p>\u03a4\u03b1 \u03b9\u03b4\u03b9\u03b1\u03af\u03c4\u03b5\u03c1\u03b1 \u03c5\u03c8\u03af\u03c3\u03c5\u03c7\u03bd\u03b1 \u03ba\u03cd\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5 Renovalaser (\u03bc\u03ae\u03ba\u03bf\u03c2 \u03ba\u03cd\u03bc\u03b1\u03c4\u03bf\u03c2 2940nm) \u03c3\u03b5 \u03c3\u03c7\u03ad\u03c3\u03b7 \u03bc\u03b5 \u03c4\u03b1 \u03c3\u03c5\u03bc\u03b2\u03b1\u03c4\u03b9\u03ba\u03ac laser, \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03bf\u03cd\u03bd \u03c4\u03bf\u03c5\u03c2 \u03b9\u03bd\u03bf\u03b2\u03bb\u03ac\u03c3\u03c4\u03b5\u03c2 \u03c3\u03c4\u03bf \u03b2\u03ac\u03b8\u03bf\u03c2 \u03c4\u03bf\u03c5 \u03b4\u03ad\u03c1\u03bc\u03b1\u03c4\u03bf\u03c2, \u03c0\u03b1\u03c1\u03ac\u03b3\u03bf\u03bd\u03c4\u03b1\u03c2 \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf, \u03b5\u03bd\u03ce \u03b7 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03bd\u03c4\u03b5\u03bb\u03ce\u03c2 \u03b1\u03bd\u03ce\u03b4\u03c5\u03bd\u03b7 \u03bb\u03cc\u03b3\u03c9 \u03c4\u03b7\u03c2 \u03b9\u03b4\u03b9\u03b1\u03b9\u03c4\u03b5\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c4\u03b7\u03c2 \u03ba\u03c5\u03bc\u03b1\u03c4\u03bf\u03bc\u03bf\u03c1\u03c6\u03ae\u03c2 \u03c4\u03bf\u03c5 erbium laser. \u0397 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03c9\u03bd \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03b9\u03ce\u03bd \u03c6\u03c4\u03ac\u03bd\u03b5\u03b9 \u03c3\u03c4\u03bf 90% \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b5\u03c2 \u03bc\u03b1\u03c2, \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bc\u03c6\u03c9\u03bd\u03bf\u03cd\u03bd \u03b1\u03c0\u03cc\u03bb\u03c5\u03c4\u03b1 \u03bc\u03b5 \u03c4\u03b7 \u03b4\u03b9\u03b5\u03b8\u03bd\u03ae \u03b2\u03b9\u03b2\u03bb\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1, \u03b5\u03bd\u03ce \u03b7 \u03b9\u03ba\u03b1\u03bd\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03b1\u03c3\u03b8\u03b5\u03bd\u03ce\u03bd \u03bc\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03ba\u03bb\u03af\u03bc\u03b1\u03ba\u03b1 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2, \u03c0\u03c1\u03b9\u03bd \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03c4\u03b9\u03c2 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2 \u03c6\u03c4\u03ac\u03bd\u03b5\u03b9 \u03c3\u03c4\u03bf 8,9 \u03c3\u03c4\u03b1 10.<\/p>\n<p>\u0397 \u03af\u03b4\u03b9\u03b1 \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03c2 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03b5\u03c6\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2 \u03bc\u03b5 \u03ba\u03b1\u03bd\u03bf\u03bd\u03b9\u03ba\u03ae \u03c0\u03b5\u03c1\u03af\u03bf\u03b4\u03bf, \u03c3\u03c5\u03bd\u03ae\u03b8\u03c9\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b1 35 \u03ad\u03c4\u03b7 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac, \u03b3\u03b9\u03b1 \u03b1\u03bd\u03ac\u03c0\u03bb\u03b1\u03c3\u03b7, \u03b2\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5, \u03cc\u03c0\u03c9\u03c2 \u03b1\u03c5\u03c4\u03cc\u03c2 \u03b1\u03c0\u03b1\u03b9\u03c4\u03b5\u03af \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03c4\u03bf\u03ba\u03b5\u03c4\u03bf\u03cd\u03c2 \u03b7 \u03b1\u03c1\u03ba\u03b5\u03c4\u03ac \u03ad\u03c4\u03b7 \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ce\u03bd \u03b5\u03c0\u03b1\u03c6\u03ce\u03bd \u03ba\u03b1\u03b9 \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ce\u03bd \u03c6\u03bb\u03b5\u03b3\u03bc\u03bf\u03bd\u03ce\u03bd \u03c0\u03bf\u03c5 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03bf\u03c0\u03bf\u03b9\u03bf\u03cd\u03bd \u03c4\u03b7\u03bd \u03b1\u03af\u03c3\u03b8\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03bf\u03bc\u03b1\u03bb\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03ba\u03b1\u03b8\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c3\u03c4\u03bf \u03c3\u03b5\u03be. (\u03c3\u03cd\u03c3\u03c6\u03b9\u03be\u03b7, \u03b1\u03af\u03c3\u03b8\u03b7\u03c3\u03b7, \u03b5\u03bd\u03c5\u03b4\u03ac\u03c4\u03c9\u03c3\u03b7, \u03c1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7 \u03b1\u03c5\u03be\u03b7\u03bc\u03ad\u03bd\u03c9\u03bd \u03b5\u03ba\u03ba\u03c1\u03af\u03c3\u03b5\u03c9\u03bd)<\/p>\n<p>\u0397 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03bc\u03b5 erbium laser \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b5\u03c0\u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b1\u03bd\u03ac \u03ad\u03c4\u03bf\u03c2 \u03c3\u03c4\u03b1 \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c4\u03b7\u03c2 \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c4\u03b7\u03c1\u03b5\u03af \u03c4\u03bf \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03c0\u03ac\u03bd\u03c4\u03bf\u03c4\u03b5 \u03bd\u03b5\u03b1\u03bd\u03b9\u03ba\u03cc,\u03ae \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03bc\u03b5 \u03c4\u03b9\u03c2 \u03b1\u03bd\u03ac\u03b3\u03ba\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03b5\u03c0\u03b9\u03b8\u03c5\u03bc\u03af\u03b5\u03c2 \u03c4\u03c9\u03bd \u03bd\u03b5\u03b1\u03c1\u03cc\u03c4\u03b5\u03c1\u03c9\u03bd \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03ce\u03bd.<\/p>\n<h2>\u0391\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5 &#8211; \u0395\u03bd\u03ad\u03c3\u03b9\u03bc\u03b5\u03c2 \u0398\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2<\/h2>\n<p><img loading=\"lazy\" class=\"aligncenter wp-image-1661 size-medium\" src=\"https:\/\/lvriathens.com\/wp-content\/uploads\/2021\/03\/eikona3-300x225.jpg\" alt=\"\u0391\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5 - \u0395\u03bd\u03ad\u03c3\u03b9\u03bc\u03b7 \u0398\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1\" width=\"300\" height=\"225\" srcset=\"https:\/\/lvriathens.com\/wp-content\/uploads\/2021\/03\/eikona3-300x225.jpg 300w, https:\/\/lvriathens.com\/wp-content\/uploads\/2021\/03\/eikona3.jpg 620w\" sizes=\"(max-width: 300px) 100vw, 300px\" \/>\u03a4\u03b1 \u03b2\u03b1\u03c1\u03b9\u03ac \u03cc\u03c0\u03bb\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b1\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bf\u03b9 \u03b5\u03bd\u03ad\u03c3\u03b9\u03bc\u03b5\u03c2 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2 \u03bf\u03b9 \u03bf\u03c0\u03bf\u03af\u03b5\u03c2, \u03b1\u03bd\u03c4\u03af\u03b8\u03b5\u03c4\u03b1 \u03b1\u03c0\u00b4 \u03cc\u03c4\u03b9 \u03bd\u03bf\u03bc\u03af\u03b6\u03b5\u03b9 \u03bf \u03ba\u03cc\u03c3\u03bc\u03bf\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03bd\u03c4\u03b5\u03bb\u03ce\u03c2 \u03b1\u03bd\u03ce\u03b4\u03c5\u03bd\u03b5\u03c2 \u03ba\u03b1\u03b8\u03ce\u03c2 \u03c0\u03c1\u03bf\u03b7\u03b3\u03b5\u03af\u03c4\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03ad\u03bd\u03b5\u03c3\u03b7\u03c2, \u03c4\u03bf\u03c0\u03b9\u03ba\u03ae \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b1\u03bd\u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03b9\u03ba\u03ae\u03c2 \u03b1\u03bb\u03bf\u03b9\u03c6\u03ae\u03c2 (\u03bc\u03b5 \u03c3\u03c5\u03bd\u03b4\u03c5\u03b1\u03c3\u03bc\u03cc \u03be\u03c5\u03bb\u03bf\u03ba\u03b1\u0390\u03bd\u03b7\u03c2, \u03bb\u03b9\u03b4\u03bf\u03ba\u03b1\u03af\u03bd\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b5\u03c4\u03c1\u03b1\u03ba\u03b1\u03af\u03bd\u03b7\u03c2) \u03c0\u03bf\u03c5 \u03b5\u03be\u03b1\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c4\u03bf\u03c0\u03b9\u03ba\u03cc \u03ac\u03bb\u03b3\u03bf\u03c2.<\/p>\n<p>\u03a4\u03bf \u03c5\u03b1\u03bb\u03bf\u03c5\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bf\u03be\u03cd \u03c5\u03c8\u03b7\u03bb\u03bf\u03cd \u03bc\u03bf\u03c1\u03b9\u03b1\u03ba\u03bf\u03cd \u03b2\u03ac\u03c1\u03bf\u03c5\u03c2 \u0397\u0391, \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03b5\u03be\u03ad\u03c7\u03bf\u03c5\u03c3\u03b1 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03b4\u03b9\u03cc\u03c1\u03b8\u03c9\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b9\u03c6\u03b1\u03bd\u03b5\u03b9\u03b1\u03ba\u03ae\u03c2 \u03b4\u03c5\u03c3\u03c0\u03b1\u03c1\u03b5\u03c5\u03bd\u03af\u03b1\u03c2 (\u03c4\u03bf\u03c5 \u03c0\u03cc\u03bd\u03bf\u03c5 \u03b4\u03b7\u03bb\u03b1\u03b4\u03ae \u03c3\u03c4\u03bf \u03c3\u03b5\u03be \u03c0\u03bf\u03c5 \u03b5\u03bd\u03c4\u03bf\u03c0\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b5\u03af\u03c3\u03bf\u03b4\u03bf \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5).<\/p>\n<h2>\u0391\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5 &#8211; \u0395\u03bd\u03ad\u03c3\u03b9\u03bc\u03b5\u03c2 \u0398\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2: \u0394\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1<\/h2>\n<p>\u0397 \u03ad\u03bd\u03b5\u03c3\u03b7 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf\u03bd \u03c5\u03c0\u03bf\u03b4\u03cc\u03c1\u03b9\u03bf \u03b9\u03c3\u03c4\u03cc \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5, \u03c3\u03c4\u03b7\u03bd \u03b5\u03af\u03c3\u03bf\u03b4\u03bf \u03ae \u03c0\u03c1\u03cc\u03b4\u03bf\u03bc\u03bf, \u03c3\u03c4\u03b1 \u03bf\u03c0\u03af\u03c3\u03b8\u03b9\u03b1 \u03c4\u03bf\u03b9\u03c7\u03ce\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03bf \u03c0\u03b5\u03c1\u03af\u03bd\u03b5\u03bf (\u03c3\u03c4\u03bf \u03c7\u03ce\u03c1\u03bf \u03bc\u03b5\u03c4\u03b1\u03be\u03cd \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c0\u03c1\u03c9\u03ba\u03c4\u03bf\u03cd. \u03a7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c0\u03c1\u03bf\u03c3\u03b5\u03ba\u03c4\u03b9\u03ba\u03ae \u03c4\u03bf\u03c0\u03bf\u03b8\u03ad\u03c4\u03b7\u03c3\u03b7, \u03c3\u03c7\u03b5\u03c4\u03b9\u03ba\u03ac \u03b5\u03c0\u03b9\u03c6\u03b1\u03bd\u03b5\u03b9\u03b1\u03ba\u03ac \u03ba\u03b1\u03b9 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03c1\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf\u03c5\u03c2 \u03b9\u03c3\u03c4\u03bf\u03cd\u03c2, \u03ba\u03b1\u03c4\u03cc\u03c0\u03b9\u03bd \u03bc\u03ac\u03bb\u03b1\u03be\u03b7\u03c2. \u03a4\u03bf \u03c5\u03b1\u03bb\u03bf\u03c5\u03c1\u03bf\u03bd\u03b9\u03ba\u03cc \u03bf\u03be\u03cd \u03b4\u03c1\u03b1 \u03c3\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1 \u03bf\u03c3\u03bc\u03c9\u03c4\u03b9\u03ba\u03ac \u03ba\u03b1\u03b9 \u03c0\u03b1\u03c1\u03b1\u03c3\u03cd\u03c1\u03b5\u03b9 \u03bd\u03b5\u03c1\u03cc \u03b1\u03c0\u03bf \u03c4\u03bf \u03b2\u03ac\u03b8\u03bf\u03c2 \u03c4\u03c9\u03bd \u03b9\u03c3\u03c4\u03ce\u03bd \u03b5\u03be\u03b1\u03c3\u03c6\u03b1\u03bb\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03c2 \u03b2\u03b1\u03b8\u03b5\u03b9\u03ac \u03b5\u03bd\u03c5\u03b4\u03ac\u03c4\u03c9\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03ae\u03c0\u03b9\u03b1 \u03bd\u03b5\u03bf\u03b1\u03b3\u03b3\u03b5\u03b9\u03bf\u03b3\u03ad\u03bd\u03b5\u03c3\u03b7, \u03b1\u03bd\u03b1\u03b9\u03c1\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7\u03bd \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1, \u03c4\u03b7\u03bd \u03bb\u03ad\u03c0\u03c4\u03c5\u03bd\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03bd \u03c0\u03cc\u03bd\u03bf \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03c6\u03ae.<\/p>\n<p>\u0397 \u03b5\u03bd\u03ad\u03c3\u03b9\u03bc\u03b7 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 PRP \u03c4\u03ad\u03bb\u03bf\u03c2 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03af\u03c3\u03c9\u03c2 \u03c4\u03bf \u03bc\u03b5\u03b3\u03b1\u03bb\u03cd\u03c4\u03b5\u03c1\u03bf \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf \u03b1\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ba\u03b1\u03b8\u03ce\u03c2 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd \u03b1\u03af\u03bc\u03b1\u03c4\u03bf\u03c2, \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03b5\u03ba\u03c4\u03b5\u03c4\u03b1\u03bc\u03ad\u03bd\u03b7 \u03c6\u03c5\u03b3\u03bf\u03ba\u03ad\u03bd\u03c4\u03c1\u03b9\u03c3\u03b7, \u03ce\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03b1\u03c5\u03be\u03b7\u03b8\u03b5\u03af \u03b7 \u03c0\u03c5\u03ba\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03c9\u03bd \u03b1\u03b9\u03bc\u03bf\u03c0\u03b5\u03c4\u03b1\u03bb\u03af\u03c9\u03bd \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b5\u03be\u03b1\u03bb\u03b5\u03b9\u03c6\u03b8\u03bf\u03cd\u03bd \u03c4\u03b1 \u03b5\u03c1\u03c5\u03b8\u03c1\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03bb\u03b5\u03c5\u03ba\u03ac \u03b1\u03b9\u03bc\u03bf\u03c3\u03c6\u03b1\u03af\u03c1\u03b9\u03b1 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03bb\u03ac\u03c3\u03bc\u03b1.<\/p>\n<p>\u03a4\u03b1 \u03b1\u03b9\u03bc\u03bf\u03c0\u03b5\u03c4\u03ac\u03bb\u03b9\u03b1 \u03c3\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1 \u03c6\u03c9\u03c4\u03bf\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03ad\u03c4\u03c3\u03b9 \u03c0\u03b1\u03c1\u03ac\u03b3\u03bf\u03c5\u03bd \u03c4\u03bf\u03c0\u03b9\u03ba\u03ac \u03c4\u03c1\u03bf\u03c6\u03b9\u03ba\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03c5\u03be\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03c0\u03b1\u03c1\u03ac\u03b3\u03bf\u03bd\u03c4\u03b5\u03c2 (PGF growth factors) \u03c4\u03bf\u03c5\u03c2 \u03bf\u03c0\u03bf\u03af\u03bf\u03c5\u03c2 \u03b1\u03c0\u03b5\u03bb\u03b5\u03c5\u03b8\u03b5\u03c1\u03ce\u03bd\u03bf\u03c5\u03bd \u03c3\u03c4\u03bf\u03c5\u03c2 \u03b9\u03c3\u03c4\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b4\u03c1\u03bf\u03c5\u03bd \u03ad\u03c4\u03c3\u03b9 \u03c0\u03b1\u03c1\u03ac\u03b3\u03bf\u03bd\u03c4\u03b1\u03c2 \u03bd\u03ad\u03b1 \u03b1\u03b3\u03b3\u03b5\u03af\u03b1 \u03ba\u03b1\u03b9 \u03bd\u03b5\u03cd\u03c1\u03b1.<\/p>\n<p>\u039c\u03b5 \u03c4\u03bf\u03bd \u03c4\u03c1\u03cc\u03c0\u03bf \u03b1\u03c5\u03c4\u03cc \u03bf\u03b9 \u03b2\u03bb\u03b5\u03bd\u03bd\u03bf\u03b3\u03cc\u03bd\u03bf\u03b9 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03cc\u03c7\u03b9 \u03bc\u03cc\u03bd\u03bf \u03bd\u03b5\u03b1\u03c1\u03bf\u03c0\u03bf\u03b9\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1\u03bc\u03b1\u03c4\u03ac\u03b5\u03b9 \u03b7 \u03b5\u03bd\u03bf\u03c7\u03bb\u03b7\u03c4\u03b9\u03ba\u03ae \u03b1\u03c4\u03c1\u03bf\u03c6\u03af\u03b1 \u03ba\u03b1\u03b9 \u03b7 \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1, \u03b1\u03bb\u03bb\u03ac \u03b7 \u03bd\u03b5\u03bf\u03bd\u03b5\u03c5\u03c1\u03bf\u03b3\u03ad\u03bd\u03b5\u03c3\u03b7 \u03c3\u03c5\u03bc\u03b2\u03ac\u03bb\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b1\u03cd\u03be\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2, \u03b2\u03bf\u03b7\u03b8\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7\u03bd \u03ac\u03c1\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c0\u03cc\u03bd\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03c6\u03ae.<\/p>\n<p>\u03a4\u03b1\u03c5\u03c4\u03cc\u03c7\u03c1\u03bf\u03bd\u03b1 \u03b7 \u03b5\u03ba\u03c4\u03b5\u03c4\u03b1\u03bc\u03ad\u03bd\u03b7 \u03b5\u03bd\u03b1\u03c0\u03cc\u03b8\u03b5\u03c3\u03b7 PRP \u03c3\u03c4\u03b7\u03bd \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae \u03b5\u03c0\u03b9\u03c6\u03ac\u03bd\u03b5\u03b9\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b1\u03cd\u03be\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03b5\u03af\u03b1\u03c2 \u03bf\u03c1\u03b3\u03b1\u03c3\u03bc\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2, \u03b5\u03bd\u03b9\u03c3\u03c7\u03cd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf \u03c3\u03b7\u03bc\u03b5\u03af\u03bf G \u03c0\u03af\u03c3\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03b5\u03af\u03b1 \u03bf\u03c5\u03c1\u03ae\u03b8\u03c1\u03b1.<\/p>\n<h2>\u0391\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u039a\u03cc\u03bb\u03c0\u03bf\u03c5 &#8211; \u0391\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ad\u03c2 \u0398\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2<\/h2>\n<p>\u039f\u03b9 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2 \u03b1\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b9\u03b4\u03b9\u03b1\u03af\u03c4\u03b5\u03c1\u03b1 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03c9\u03c2 \u03b5\u03ba \u03c4\u03bf\u03cd\u03c4\u03bf\u03c5 \u03b5\u03bb\u03ba\u03c5\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03ba\u03b1\u03b8\u03ce\u03c2 \u03b7 \u03ba\u03b1\u03b8\u03b5\u03bc\u03af\u03b1 \u03b1\u03c0\u03bf\u03ba\u03b1\u03b8\u03b9\u03c3\u03c4\u03ac \u03ba\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03be\u03b5\u03c7\u03c9\u03c1\u03b9\u03c3\u03c4\u03cc \u03c3\u03c5\u03c3\u03c4\u03b1\u03c4\u03b9\u03ba\u03cc \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03c7\u03ac\u03bd\u03b5\u03c4\u03b1\u03b9, \u03bc\u03b5 \u03c4\u03b7\u03bd \u03b5\u03bb\u03b1\u03c7\u03b9\u03c3\u03c4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03bf\u03c1\u03bc\u03bf\u03bd\u03ce\u03bd \u03ae \u03c4\u03b7\u03bd \u03c0\u03ac\u03c1\u03bf\u03b4\u03bf \u03c4\u03bf\u03c5 \u03c7\u03c1\u03cc\u03bd\u03bf\u03c5 \u03c3\u03c4\u03b9\u03c2 \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b5\u03c2.<\/p>\n<p>\u0391\u03c0\u03bb\u03ac \u03b1\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03c5\u03c0\u03bf\u03bc\u03bf\u03bd\u03ae \u03ba\u03b1\u03b9 \u03c3\u03c9\u03c3\u03c4\u03ae \u03b5\u03ba\u03c4\u03ad\u03bb\u03b5\u03c3\u03b7, \u03bc\u03b5 \u03c4\u03b7\u03bd \u03bf\u03c1\u03b8\u03ae \u03c3\u03b5\u03b9\u03c1\u03ac, \u03c4\u03c9\u03bd \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03b9\u03ce\u03bd \u03ce\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03b1\u03b3\u03b3\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c4\u03bf \u03b9\u03b4\u03b1\u03bd\u03b9\u03ba\u03cc \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1, \u03b5\u03be\u03b1\u03c4\u03bf\u03bc\u03b9\u03ba\u03b5\u03cd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf \u03b5\u03ba\u03ac\u03c3\u03c4\u03bf\u03c4\u03b5 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c4\u03b1\u03c4\u03b9\u03ba\u03cc. \u03a0\u03c1\u03c9\u03c4\u03b1\u03c1\u03c7\u03b9\u03ba\u03ac \u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c4\u03bf\u03c5 erbium laser \u03b3\u03b9\u03b1 \u03b5\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03c9\u03c3\u03b7, \u03bc