{"id":569,"date":"2018-10-11T07:10:15","date_gmt":"2018-10-11T07:10:15","guid":{"rendered":"https:\/\/lvriathens.com\/?p=569\/"},"modified":"2022-05-30T16:03:33","modified_gmt":"2022-05-30T13:03:33","slug":"plastiki-kolpou-vlaves-pou-diorthonei","status":"publish","type":"post","link":"https:\/\/lvriathens.com\/plastiki-kolpou-vlaves-pou-diorthonei\/","title":{"rendered":"\u03a0\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 &#8211; \u03c0\u03bf\u03b9\u03b5\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03c5\u03bd\u03bf\u03c0\u03c4\u03b9\u03ba\u03ac \u03bf\u03b9 \u03ba\u03c5\u03c1\u03b9\u03cc\u03c4\u03b5\u03c1\u03b5\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03b4\u03b9\u03bf\u03c1\u03b8\u03ce\u03bd\u03b5\u03b9;"},"content":{"rendered":"<p style=\"text-align: justify;\">\u0397 \u03c3\u03c5\u03c7\u03bd\u03cc\u03c4\u03b5\u03c1\u03b7 \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03b2\u03bb\u03ac\u03b2\u03b7 \u03c0\u03bf\u03c5 \u03b2\u03b9\u03ce\u03bd\u03b5\u03b9 \u03b7 \u03c0\u03bb\u03b5\u03b9\u03bf\u03c8\u03b7\u03c6\u03af\u03b1 \u03c4\u03c9\u03bd \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03ce\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ae \u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7, \u03b7 \u03c3\u03c7\u03b5\u03c4\u03b9\u03ba\u03ae \u03b1\u03b4\u03c1\u03ac\u03bd\u03b5\u03b9\u03b1 \u03c4\u03c9\u03bd \u03bc\u03c5\u03ce\u03bd \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5\u00a0\u03b4\u03b7\u03bb\u03b1\u03b4\u03ae \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae.<\/p>\n<p style=\"text-align: justify;\">\u03a3\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1, \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03bc\u03b5 \u03c4\u03bf \u03c4\u03bc\u03ae\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03c0\u03ac\u03c3\u03c7\u03b5\u03b9, \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bc\u03b5 \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b1\u03bd\u03c4\u03ae\u03c3\u03bf\u03c5\u03bc\u03b5 \u03b1)\u03ba\u03c5\u03c3\u03c4\u03b5\u03bf\u03ba\u03ae\u03bb\u03b7 (\u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bf\u03c5\u03c1\u03bf\u03b4\u03cc\u03c7\u03bf\u03c5 \u03ba\u03cd\u03c3\u03c4\u03b7\u03c2 \u03c3\u03c4\u03bf \u03c0\u03c1\u03cc\u03c3\u03b8\u03b9\u03bf \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03cc \u03c4\u03bf\u03af\u03c7\u03c9\u03bc\u03b1) \u03bc\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03ba\u03b1\u03c4\u03b1\u03ba\u03c1\u03ac\u03c4\u03b7\u03c3\u03b7 \u03bf\u03cd\u03c1\u03c9\u03bd \u03ae \u03b1\u03bd\u03c4\u03af\u03b8\u03b5\u03c4\u03b1 \u03b1\u03ba\u03c1\u03ac\u03c4\u03b5\u03b9\u03b1 \u03bf\u03cd\u03c1\u03c9\u03bd \u03c0\u03c1\u03bf\u03c3\u03c0\u03b1\u03b8\u03b5\u03af\u03b1\u03c2 \u03b2)\u03b5\u03bd\u03c4\u03b5\u03c1\u03bf\u03ba\u03ae\u03bb\u03b7 (\u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03b5\u03bd\u03c4\u03ad\u03c1\u03bf\u03c5 \u03c3\u03c4\u03bf \u03bf\u03c0\u03af\u03c3\u03b8\u03b9\u03bf \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03cc \u03c4\u03bf\u03af\u03c7\u03c9\u03bc\u03b1 )\u03bc\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03bf\u03c1\u03b8\u03bf\u03ba\u03ae\u03bb\u03b7 \u03ba\u03b1\u03b9 \u03b4\u03c5\u03c3\u03ba\u03bf\u03b9\u03bb\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ae \u03b3)\u03c0\u03c4\u03ce\u03c3\u03b7 \u03bc\u03ae\u03c4\u03c1\u03b1\u03c2 (\u03ba\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03cc \u03b4\u03b9\u03b1\u03bc\u03ad\u03c1\u03b9\u03c3\u03bc\u03b1 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 ) \u03ac\u03bb\u03bb\u03bf\u03c4\u03b5 \u03ac\u03bb\u03bb\u03bf\u03c5 \u03b2\u03b1\u03b8\u03bc\u03bf\u03cd \u03c0\u03bf\u03c5 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03ba\u03b1\u03c4\u03b1\u03bb\u03ae\u03be\u03b5\u03b9 \u03bc\u03ad\u03c7\u03c1\u03b9 \u03c4\u03b7\u03bd \u03bf\u03bb\u03b9\u03ba\u03ae \u03ad\u03be\u03bf\u03b4\u03bf \u03c4\u03b7\u03c2 \u03bc\u03ae\u03c4\u03c1\u03b1\u03c2 \u03b1\u03c0\u2019\u03c4\u03bf\u03bd \u03ba\u03cc\u03bb\u03c0\u03bf.<\/p>\n<h2 style=\"text-align: justify;\">\u038c\u03bb\u03b5\u03c2 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03bf\u03b9 \u03c0\u03b1\u03b8\u03ae\u03c3\u03b5\u03b9\u03c2 \u03b4\u03b9\u03bf\u03c1\u03b8\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03bc\u03b5 \u03c0\u03bf\u03b9\u03bf \u03c4\u03c1\u03cc\u03c0\u03bf;<\/h2>\n<p style=\"text-align: justify;\">\u0397 \u03b1\u03c0\u03bb\u03ae \u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03c6\u03ae \u03b4\u03b9\u03bf\u03c1\u03b8\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c0\u03bf\u03bb\u03cd \u03b5\u03cd\u03ba\u03bf\u03bb\u03b1 ,\u03b3\u03c1\u03ae\u03b3\u03bf\u03c1\u03b1 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03ce\u03b4\u03c5\u03bd\u03b1 \u03bc\u03b5 \u03c4\u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 Laser Co2 \u03c3\u03cd\u03bc\u03c6\u03c9\u03bd\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae LVR (laser vaginal rejuvenation), \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ae \u03b4\u03bb\u03b4 \u03b1\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 ,\u03c3\u03cd\u03bc\u03c6\u03c9\u03bd\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03bf\u03c1\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03bf \u03c0\u03c1\u03ce\u03c4\u03bf\u03c2 \u03b4\u03b9\u03b4\u03ac\u03be\u03b1\u03c2 \u03c3\u03c4\u03b7\u03bd \u0391\u03bc\u03b5\u03c1\u03b9\u03ba\u03ae (David Matlock), \u03bc\u03b5 \u03c4\u03bf\u03bd \u03bf\u03c0\u03bf\u03af\u03bf \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03c3\u03b1\u03bc\u03b5 \u03c3\u03c4\u03b7\u03bd \u0391\u03b8\u03ae\u03bd\u03b1 \u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03c4\u03c5\u03c0\u03b7 \u03ba\u03bb\u03b9\u03bd\u03b9\u03ba\u03ae LVRI Athens, \u03c4\u03b7\u03bd \u03bf\u03c0\u03bf\u03af\u03b1 \u03ba\u03b1\u03b9 \u03b4\u03b9\u03b5\u03c5\u03b8\u03cd\u03bd\u03c9. \u039f \u03ba\u03cc\u03bb\u03c0\u03bf\u03c2 \u03b1\u03c0\u03bf\u03ba\u03c4\u03ac \u03ad\u03c4\u03c3\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c3\u03c0\u03b1\u03c1\u03b3\u03ae, \u03bc\u03b5 \u03c4\u03b5\u03c1\u03ac\u03c3\u03c4\u03b9\u03b1 \u03b2\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c4\u03b7\u03c2 \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ae\u03c2 \u03b5\u03c0\u03b1\u03c6\u03ae\u03c2.<\/p>\n<p style=\"text-align: justify;\">\u03a4\u03b7\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 laser \u03cc\u03bc\u03c9\u03c2 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b5\u03ba\u03c4\u03b5\u03af\u03bd\u03b1\u03bc\u03b5 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b9\u03c2 \u03b2\u03b1\u03c1\u03cd\u03c4\u03b5\u03c1\u03b5\u03c2 \u03c0\u03b1\u03b8\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03cc\u03c1\u03bf TVR (total vaginal reconstruction) \u03bf\u03bb\u03b9\u03ba\u03ae \u03b4\u03b7\u03bb\u03b1\u03b4\u03ae \u03b1\u03bd\u03b1\u03b4\u03cc\u03bc\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03bc\u03b5 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c4\u03c9\u03bd \u03c3\u03c4\u03bf\u03b9\u03c7\u03b5\u03af\u03c9\u03bd \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5\u03c2 \u03b8\u03ad\u03c3\u03b7, \u03bc\u03b5 \u03c4\u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03b5\u03b9\u03b4\u03b9\u03ba\u03ce\u03bd \u03c0\u03bb\u03b5\u03b3\u03bc\u03ac\u03c4\u03c9\u03bd \u03b1\u03c0\u03cc \u03b1\u03b4\u03c1\u03b1\u03bd\u03ae \u03ae \u03b1\u03c0\u03bf\u03c1\u03c1\u03bf\u03c6\u03ae\u03c3\u03b9\u03bc\u03b1 \u03c5\u03bb\u03b9\u03ba\u03ac. \u0388\u03c4\u03c3\u03b9 \u03b4\u03b9\u03bf\u03c1\u03b8\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b5\u03bd\u03c4\u03b5\u03bb\u03ce\u03c2 \u03cc\u03c7\u03b9 \u03bc\u03cc\u03bd\u03bf \u03bf\u03b9 \u03b1\u03bd\u03b1\u03c4\u03bf\u03bc\u03b9\u03ba\u03ad\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c4\u03ce\u03c3\u03b7\u03c2 \u03c4\u03c9\u03bd \u03bf\u03c1\u03b3\u03ac\u03bd\u03c9\u03bd \u03b1\u03bb\u03bb\u03ac \u03b5\u03c0\u03b1\u03bd\u03ad\u03c1\u03c7\u03b5\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03b7 \u03bf\u03bc\u03b1\u03bb\u03ae \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c4\u03b7\u03c2 \u03bf\u03c5\u03c1\u03bf\u03b4\u03cc\u03c7\u03bf\u03c5 \u03ba\u03cd\u03c3\u03c4\u03b7\u03c2 , \u03c4\u03bf\u03c5 \u03b5\u03bd\u03c4\u03ad\u03c1\u03bf\u03c5 \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03bc\u03ae\u03c4\u03c1\u03b1\u03c2.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0397 \u03c3\u03c5\u03c7\u03bd\u03cc\u03c4\u03b5\u03c1\u03b7 \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03b2\u03bb\u03ac\u03b2\u03b7 \u03c0\u03bf\u03c5 \u03b2\u03b9\u03ce\u03bd\u03b5\u03b9 \u03b7 \u03c0\u03bb\u03b5\u03b9\u03bf\u03c8\u03b7\u03c6\u03af\u03b1 \u03c4\u03c9\u03bd \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03ce\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ae \u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7, \u03b7 \u03c3\u03c7\u03b5\u03c4\u03b9\u03ba\u03ae \u03b1\u03b4\u03c1\u03ac\u03bd\u03b5\u03b9\u03b1 \u03c4\u03c9\u03bd \u03bc\u03c5\u03ce\u03bd \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5\u00a0\u03b4\u03b7\u03bb\u03b1\u03b4\u03ae \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae. \u03a3\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1, \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03bc\u03b5 \u03c4\u03bf \u03c4\u03bc\u03ae\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03c0\u03ac\u03c3\u03c7\u03b5\u03b9, \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bc\u03b5 \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b1\u03bd\u03c4\u03ae\u03c3\u03bf\u03c5\u03bc\u03b5 \u03b1)\u03ba\u03c5\u03c3\u03c4\u03b5\u03bf\u03ba\u03ae\u03bb\u03b7 (\u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bf\u03c5\u03c1\u03bf\u03b4\u03cc\u03c7\u03bf\u03c5 \u03ba\u03cd\u03c3\u03c4\u03b7\u03c2 \u03c3\u03c4\u03bf \u03c0\u03c1\u03cc\u03c3\u03b8\u03b9\u03bf \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03cc \u03c4\u03bf\u03af\u03c7\u03c9\u03bc\u03b1) \u03bc\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03ba\u03b1\u03c4\u03b1\u03ba\u03c1\u03ac\u03c4\u03b7\u03c3\u03b7 \u03bf\u03cd\u03c1\u03c9\u03bd \u03ae \u03b1\u03bd\u03c4\u03af\u03b8\u03b5\u03c4\u03b1 \u03b1\u03ba\u03c1\u03ac\u03c4\u03b5\u03b9\u03b1 \u03bf\u03cd\u03c1\u03c9\u03bd&hellip;<\/p>\n","protected":false},"author":8,"featured_media":1511,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":[],"categories":[1],"tags":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v18.9 - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>\u03a0\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 - \u03c0\u03bf\u03b9\u03b5\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03c5\u03bd\u03bf\u03c0\u03c4\u03b9\u03ba\u03ac \u03bf\u03b9 \u03ba\u03c5\u03c1\u03b9\u03cc\u03c4\u03b5\u03c1\u03b5\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03b4\u03b9\u03bf\u03c1\u03b8\u03ce\u03bd\u03b5\u03b9; | LVRI<\/title>\n<meta name=\"robots\" content=\"noindex, follow\" \/>\n<meta property=\"og:locale\" content=\"el_GR\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"\u03a0\u03bb\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 - \u03c0\u03bf\u03b9\u03b5\u03c2 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03c5\u03bd\u03bf\u03c0\u03c4\u03b9\u03ba\u03ac \u03bf\u03b9 \u03ba\u03c5\u03c1\u03b9\u03cc\u03c4\u03b5\u03c1\u03b5\u03c2 \u03b2\u03bb\u03ac\u03b2\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03b4\u03b9\u03bf\u03c1\u03b8\u03ce\u03bd\u03b5\u03b9; | LVRI\" \/>\n<meta property=\"og:description\" content=\"\u0397 \u03c3\u03c5\u03c7\u03bd\u03cc\u03c4\u03b5\u03c1\u03b7 \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03b2\u03bb\u03ac\u03b2\u03b7 \u03c0\u03bf\u03c5 \u03b2\u03b9\u03ce\u03bd\u03b5\u03b9 \u03b7 \u03c0\u03bb\u03b5\u03b9\u03bf\u03c8\u03b7\u03c6\u03af\u03b1 \u03c4\u03c9\u03bd \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03ce\u03bd \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ae \u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7, \u03b7 \u03c3\u03c7\u03b5\u03c4\u03b9\u03ba\u03ae \u03b1\u03b4\u03c1\u03ac\u03bd\u03b5\u03b9\u03b1 \u03c4\u03c9\u03bd \u03bc\u03c5\u03ce\u03bd \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5\u00a0\u03b4\u03b7\u03bb\u03b1\u03b4\u03ae \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae. \u03a3\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1, \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03bc\u03b5 \u03c4\u03bf \u03c4\u03bc\u03ae\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03c0\u03ac\u03c3\u03c7\u03b5\u03b9, \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bc\u03b5 \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b1\u03bd\u03c4\u03ae\u03c3\u03bf\u03c5\u03bc\u03b5 \u03b1)\u03ba\u03c5\u03c3\u03c4\u03b5\u03bf\u03ba\u03ae\u03bb\u03b7 (\u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bf\u03c5\u03c1\u03bf\u03b4\u03cc\u03c7\u03bf\u03c5 \u03ba\u03cd\u03c3\u03c4\u03b7\u03c2 \u03c3\u03c4\u03bf \u03c0\u03c1\u03cc\u03c3\u03b8\u03b9\u03bf \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03cc \u03c4\u03bf\u03af\u03c7\u03c9\u03bc\u03b1) \u03bc\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03ba\u03b1\u03c4\u03b1\u03ba\u03c1\u03ac\u03c4\u03b7\u03c3\u03b7 \u03bf\u03cd\u03c1\u03c9