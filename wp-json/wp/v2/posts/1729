03c1\u03b1\u03b3\u03c9\u03b3\u03ae \u03c4\u03bf\u03c5\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03bf\u03c6\u03b5\u03af\u03bb\u03b5\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03c3\u03b5 \u03ac\u03bb\u03bb\u03bf\u03c5\u03c2 \u03c0\u03b1\u03c1\u03ac\u03b3\u03bf\u03bd\u03c4\u03b5\u03c2, \u03b5\u03ba\u03c4\u03cc\u03c2 \u03c4\u03b7\u03c2 \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7\u03c2, \u03cc\u03c0\u03c9\u03c2:<\/strong><\/p>\n<ul>\n<li>\u039f\u03c1\u03bc\u03bf\u03bd\u03b9\u03ba\u03ae \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03bc\u03b5 \u03b1\u03bd\u03c4\u03b9-\u03bf\u03b9\u03c3\u03c4\u03c1\u03bf\u03b3\u03cc\u03bd\u03b1<\/li>\n<li>\u03a7\u03b5\u03b9\u03c1\u03bf\u03c5\u03c1\u03b3\u03b5\u03af\u03bf \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b1\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03b7 \u03c9\u03bf\u03b8\u03b7\u03ba\u03ce\u03bd<\/li>\n<li>\u03a7\u03b7\u03bc\u03b5\u03b9\u03bf\u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03ba\u03c4\u03b9\u03bd\u03bf\u03b2\u03bf\u03bb\u03af\u03b5\u03c2<\/li>\n<li>\u0395\u03b3\u03ba\u03c5\u03bc\u03bf\u03c3\u03cd\u03bd\u03b7 \u03ba\u03b1\u03b9 \u03b8\u03b7\u03bb\u03b1\u03c3\u03bc\u03cc\u03c2<\/li>\n<li>\u039c\u03b7 \u03b5\u03bd\u03b4\u03b5\u03b4\u03b5\u03b9\u03b3\u03bc\u03ad\u03bd\u03b7 \u03b1\u03c0\u03cc \u03b3\u03b9\u03b1\u03c4\u03c1\u03cc \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03b3\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b1\u03c1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5- \u03a0\u03c1\u03cc\u03ba\u03b5\u03b9\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03bf\u03ba\u03b1\u03b8\u03b1\u03c1\u03af\u03b6\u03bf\u03bc\u03b5\u03bd\u03bf \u03cc\u03c1\u03b3\u03b1\u03bd\u03bf \u03ba\u03b1\u03b9 \u03b4\u03b5 \u03c7\u03c1\u03b5\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03ba\u03bb\u03b7\u03c1\u03ac \u03ba\u03b1\u03b8\u03b1\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac<\/li>\n<li>\u039a\u03ac\u03c0\u03bd\u03b9\u03c3\u03bc\u03b1<\/li>\n<li>\u03a6\u03b1\u03c1\u03bc\u03b1\u03ba\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03b1\u03b3\u03c9\u03b3\u03ae \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03ac\u03b8\u03bb\u03b9\u03c8\u03b7 \u03ae \u03c4\u03b7\u03bd \u03b1\u03bd\u03c4\u03b9\u03bc\u03b5\u03c4\u03ce\u03c0\u03b9\u03c3\u03b7 \u03b1\u03bb\u03bb\u03b5\u03c1\u03b3\u03b9\u03ce\u03bd<\/li>\n<li>\u0391\u03bd\u03bf\u03c3\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03ad\u03c2 \u03b4\u03b9\u03b1\u03c4\u03b1\u03c1\u03b1\u03c7\u03ad\u03c2 \u03bc\u03b5 \u03c4\u03bf \u03a3\u03cd\u03bd\u03b4\u03c1\u03bf\u03bc\u03bf Sjogren<\/li>\n<\/ul>\n<p>&nbsp;<\/p>\n<h2>\u03a0\u03bf\u03b9\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03b1 \u03c3\u03c5\u03bc\u03c0\u03c4\u03ce\u03bc\u03b1\u03c4\u03b1 \u03bc\u03b5 \u03c4\u03b1 \u03bf\u03c0\u03bf\u03af\u03b1 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b1\u03bd\u03c4\u03b9\u03bb\u03b7\u03c0\u03c4\u03ae;<\/h2>\n<ul>\n<li>\u0388\u03bd\u03c4\u03bf\u03bd\u03bf \u03b1\u03af\u03c3\u03b8\u03b7\u03bc\u03b1 \u03ba\u03b1\u03cd\u03c3\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c0\u03cc\u03bd\u03bf\u03c5, \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7 \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ae \u03b5\u03c0\u03b1\u03c6\u03ae<\/li>\n<li>\u03a3\u03c5\u03c7\u03bd\u03bf\u03bf\u03c5\u03c1\u03af\u03b1<\/li>\n<li>\u039f\u03c5\u03c1\u03bf\u03bb\u03bf\u03b9\u03bc\u03ce\u03be\u03b5\u03b9\u03c2<\/li>\n<li>\u039a\u03bd\u03b7\u03c3\u03bc\u03cc\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c5\u03b1\u03af\u03c3\u03b8\u03b7\u03c4\u03b7 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae<\/li>\n<\/ul>\n<p>&nbsp;<\/p>\n<h2>\u039c\u03b5 \u03c0\u03bf\u03b9\u03b5\u03c2 \u03b5\u03be\u03b5\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2 \u03bf \u03b3\u03b9\u03b1\u03c4\u03c1\u03cc\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03ba\u03ac\u03bd\u03b5\u03b9 \u03c4\u03b7 \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7;<\/h2>\n<p>\u039f \u03b3\u03b9\u03b1\u03c4\u03c1\u03cc\u03c2 \u03b1\u03c1\u03c7\u03b9\u03ba\u03ac \u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9 \u03c0\u03bb\u03ae\u03c1\u03b5\u03c2 \u03b9\u03b1\u03c4\u03c1\u03b9\u03ba\u03cc \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b1\u03c3\u03b8\u03b5\u03bd\u03ae \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1 \u03c0\u03c1\u03bf\u03c7\u03c9\u03c1\u03ac \u03c3\u03b5 \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03ad\u03c2 \u03b5\u03be\u03b5\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2. \u0391\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c0\u03b5\u03c1\u03af\u03c0\u03c4\u03c9\u03c3\u03b7 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b6\u03b7\u03c4\u03ae\u03c3\u03b5\u03b9 \u03ba\u03b1\u03b9 \u03bf\u03c1\u03bc\u03bf\u03bd\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03ad\u03c2 \u03ae \u03ba\u03c5\u03c4\u03c4\u03b1\u03c1\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03ad\u03c2 \u03b5\u03be\u03b5\u03c4\u03ac\u03c3\u03b5\u03b9\u03c2, \u03ba\u03bf\u03bb\u03c0\u03bf\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7 \u03ae \u03ba\u03b1\u03bb\u03bb\u03b9\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1 \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03bf\u03cd \u03c5\u03b3\u03c1\u03bf\u03cd \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b4\u03ce\u03c3\u03b5\u03b9 \u03c4\u03b7\u03bd \u03bf\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7.<\/p>\n<p>&nbsp;<\/p>\n<h2>\u03a0\u03bf\u03b9\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03c0\u03b9\u03bf \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03ad\u03b8\u03bf\u03b4\u03bf\u03c2 \u03b1\u03bd\u03c4\u03b9\u03bc\u03b5\u03c4\u03ce\u03c0\u03b9\u03c3\u03ae\u03c2 \u03c4\u03b7\u03c2;<\/h2>\n<p>\u039a\u03b1\u03c4\u2019 \u03b1\u03c1\u03c7\u03ac\u03c2 \u03bf \u03b3\u03b9\u03b1\u03c4\u03c1\u03cc\u03c2 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bd\u03b5\u03b9 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03bc\u03bf\u03c1\u03c6\u03ce\u03c3\u03b5\u03c4\u03b5 \u03c4\u03bf \u03b4\u03b9\u03b1\u03c4\u03c1\u03bf\u03c6\u03b9\u03ba\u03cc \u03c3\u03b1\u03c2 \u03c0\u03bb\u03ac\u03bd\u03bf \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03c4\u03bf \u03b5\u03bc\u03c0\u03bb\u03bf\u03c5\u03c4\u03af\u03c3\u03b5\u03c4\u03b5 \u03bc\u03b5 \u03c4\u03c1\u03bf\u03c6\u03ad\u03c2 \u03c0\u03bb\u03bf\u03cd\u03c3\u03b9\u03b5\u03c2 \u03c3\u03b5 \u03bc\u03b1\u03b3\u03b3\u03ac\u03bd\u03b9\u03bf &amp; \u03ba\u03ac\u03bb\u03bb\u03b9\u03bf \u03cc\u03c0\u03c9\u03c2 \u03bf\u03b9 \u03bc\u03c0\u03b1\u03bd\u03ac\u03bd\u03b5\u03c2, \u03c3\u03b5 \u03a93 \u03bb\u03b9\u03c0\u03b1\u03c1\u03ac \u03cc\u03c0\u03c9\u03c2 \u03bf \u03c3\u03bf\u03bb\u03bf\u03bc\u03cc\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03c8\u03ac\u03c1\u03b9\u03b1, \u03b7 \u03ba\u03b1\u03bb\u03ae \u03b5\u03bd\u03c5\u03b4\u03ac\u03c4\u03c9\u03c3\u03b7 \u03bc\u03b5 \u03c0\u03bf\u03bb\u03cd \u03bd\u03b5\u03c1\u03cc, \u03b2\u03b9\u03c4\u03b1\u03bc\u03af\u03bd\u03b5\u03c2 C, D \u03ba\u03b1\u03b9 \u03926, \u03b3\u03b9\u03b1\u03bf\u03cd\u03c1\u03c4\u03b9 \u03c0\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03bb\u03bf\u03cd\u03c3\u03b9\u03bf \u03c3\u03b5 \u03c0\u03c1\u03bf\u03b2\u03b9\u03bf\u03c4\u03b9\u03ba\u03ac \u03ae \u03c7\u03c5\u03bc\u03cc cranberry \u03c0\u03bb\u03bf\u03cd\u03c3\u03b9\u03bf \u03c3\u03b5 \u03b1\u03bd\u03c4\u03b9\u03bf\u03be\u03b5\u03b9\u03b4\u03c9\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b9\u03b4\u03b9\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2.<\/p>\n<p>\u03a0\u03b9\u03bf \u03b3\u03bd\u03c9\u03c3\u03c4\u03ad\u03c2 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03bf\u03c1\u03bc\u03bf\u03bd\u03bf\u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03ae \u03b7 \u03c7\u03bf\u03c1\u03ae\u03b3\u03b7\u03c3\u03b7 \u03b5\u03bd\u03b4\u03bf\u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ce\u03bd \u03ba\u03c1\u03b5\u03bc\u03ce\u03bd.<\/p>\n<p>\u0397 \u03c3\u03cd\u03b3\u03c7\u03c1\u03bf\u03bd\u03b7 \u03b9\u03b1\u03c4\u03c1\u03b9\u03ba\u03ae \u03c0\u03c1\u03bf\u03c4\u03b5\u03af\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b5\u03be\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03ac \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03bc\u03b5 laser. \u03a4\u03bf laser \u03b5\u03b9\u03c3\u03ad\u03c1\u03c7\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b1 \u03b2\u03b1\u03b8\u03cd\u03c4\u03b5\u03c1\u03b1 \u03c4\u03bf\u03b9\u03c7\u03ce\u03bc\u03b1\u03c4\u03b1 \u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c4\u03bf\u03bd \u03ba\u03b1\u03af\u03b5\u03b9 \u03b5\u03bd\u03ce \u03b8\u03b5\u03c1\u03bc\u03b1\u03af\u03bd\u03b5\u03b9 \u03c4\u03bf \u03c5\u03c0\u03cc\u03c3\u03c4\u03c1\u03c9\u03bc\u03ac \u03c4\u03bf\u03c5. \u0388\u03c4\u03c3\u03b9, \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03b9\u03bd\u03bf\u03b2\u03bb\u03ac\u03c3\u03c4\u03b5\u03c2 \u03c0\u03b1\u03c1\u03ac\u03b3\u03b5\u03c4\u03b1\u03b9 \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf \u03ba\u03b1\u03b9 \u03bf \u03ba\u03cc\u03bb\u03c0\u03bf\u03c2 \u03b5\u03bd\u03c5\u03b4\u03b1\u03c4\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c7\u03c9\u03c1\u03af\u03c2 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03b2\u03ac\u03c1\u03c5\u03bd\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03bf\u03c1\u03b3\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd \u03bc\u03b5 \u03bb\u03ae\u03c8\u03b7 \u03bf\u03b9\u03c3\u03c4\u03c1\u03bf\u03b3\u03cc\u03bd\u03c9\u03bd.<\/p>\n<p>\u0397 \u03c0\u03bf\u03b9\u03bf\u03c4\u03b9\u03ba\u03ae \u03ba\u03b1\u03b8\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03b7 \u03c5\u03b3\u03b9\u03ae\u03c2 \u03c3\u03b5\u03be\u03bf\u03c5\u03b1\u03bb\u03b9\u03ba\u03ae \u03b6\u03c9\u03ae \u03b5\u03af\u03bd\u03b1\u03b9 \u03b4\u03b9\u03ba\u03b1\u03af\u03c9\u03bc\u03b1 \u03cc\u03bb\u03c9\u0