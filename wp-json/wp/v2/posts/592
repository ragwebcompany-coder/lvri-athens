{"id":592,"date":"2018-10-11T07:29:39","date_gmt":"2018-10-11T07:29:39","guid":{"rendered":"https:\/\/lvriathens.com\/?p=592\/"},"modified":"2022-05-30T16:04:08","modified_gmt":"2022-05-30T13:04:08","slug":"to-laser-stin-sygxroni-epoxi","status":"publish","type":"post","link":"https:\/\/lvriathens.com\/to-laser-stin-sygxroni-epoxi\/","title":{"rendered":"\u03a4\u03bf Laser \u03c3\u03c4\u03b7 \u03a3\u03cd\u03b3\u03c7\u03c1\u03bf\u03bd\u03b7 \u0395\u03c0\u03bf\u03c7\u03ae!"},"content":{"rendered":"<p style=\"text-align: justify;\">\u03a3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03bc\u03b1\u03c2 \u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c4\u03b5\u03c7\u03bd\u03bf\u03bb\u03bf\u03b3\u03af\u03b1\u03c2 laser \u03ad\u03c7\u03b5\u03b9 \u03ba\u03b1\u03c4\u03b1\u03bb\u03ae\u03be\u03b5\u03b9 \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c3\u03c5\u03bd\u03c5\u03c6\u03b1\u03c3\u03bc\u03ad\u03bd\u03b7 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c0\u03c1\u03cc\u03bf\u03b4\u03bf \u03ba\u03b1\u03b9 \u03c4\u03bf\u03bd \u03bc\u03bf\u03bd\u03c4\u03b5\u03c1\u03bd\u03b9\u03c3\u03bc\u03cc \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03c3\u03c4\u03ae\u03bc\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03b2\u03b9\u03bf\u03c4\u03b5\u03c7\u03bd\u03bf\u03bb\u03bf\u03b3\u03af\u03b1.<\/p>\n<p style=\"text-align: justify;\">\u03a3\u03c4\u03b7\u03bd \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03c0\u03cc \u03c4\u03bf 1967 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03c9\u03c4\u03bf\u03ba\u03b1\u03c4\u03b1\u03c3\u03ba\u03b5\u03c5\u03ac\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b7\u03c7\u03ac\u03bd\u03b7\u03bc\u03b1 \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2 \u03b1\u03ba\u03c4\u03af\u03bd\u03b1\u03c2 laser \u03bc\u03ad\u03c7\u03c1\u03b9 \u03c4\u03b7 \u03c3\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03ae \u03b5\u03c0\u03bf\u03c7\u03ae \u03ad\u03c7\u03bf\u03c5\u03bd \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03b7\u03b8\u03b5\u03af \u03b1\u03bb\u03bc\u03b1\u03c4\u03ce\u03b4\u03b5\u03b9\u03c2 \u03b5\u03be\u03b5\u03bb\u03af\u03be\u03b5\u03b9\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1 \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c4\u03b7 \u03c7\u03c1\u03b7\u03c3\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03bf\u03c5 laser \u03c0\u03bf\u03c5 \u03ad\u03c7\u03bf\u03c5\u03bd \u03c3\u03c5\u03bd\u03b5\u03b9\u03c3\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b2\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c0\u03b1\u03c1\u03bf\u03c7\u03ae\u03c2 \u03c5\u03c0\u03b7\u03c1\u03b5\u03c3\u03b9\u03ce\u03bd \u03c3\u03c4\u03bf\u03bd \u03c4\u03bf\u03bc\u03ad\u03b1 \u03c4\u03b7\u03c2 \u03b9\u03b1\u03c4\u03c1\u03b9\u03ba\u03ae\u03c2.<\/p>\n<p style=\"text-align: justify;\">\u0391\u03c0\u03cc \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b5\u03c5\u03b8\u03c5\u03bd\u03cc\u03bc\u03b5\u03bd\u03b7 \u03c0\u03c1\u03b1\u03ba\u03c4\u03b9\u03ba\u03ac, \u03b1\u03c0\u03bb\u03ac \u03b5\u03bd\u03b9\u03c3\u03c7\u03c5\u03bc\u03ad\u03bd\u03b7 \u03b4\u03ad\u03c3\u03bc\u03b7 \u03c6\u03c9\u03c4\u03cc\u03c2 \u03c4\u03bf\u03c5 \u03c0\u03b1\u03c1\u03b5\u03bb\u03b8\u03cc\u03bd\u03c4\u03bf\u03c2 \u03c6\u03c4\u03ac\u03c3\u03b1\u03bc\u03b5 \u03c3\u03c4\u03bf \u03b5\u03c0\u03af\u03c0\u03b5\u03b4\u03bf \u03bc\u03b9\u03b1\u03c2 \u03c0\u03bf\u03bb\u03c5\u03b4\u03cd\u03bd\u03b1\u03bc\u03b7\u03c2 \u03b1\u03ba\u03c4\u03af\u03bd\u03b1\u03c2 \u03bc\u03b5 \u03bc\u03b5\u03c4\u03b1\u03b2\u03b1\u03bb\u03bb\u03cc\u03bc\u03b5\u03bd\u03b7 \u03b8\u03b5\u03c1\u03bc\u03b9\u03ba\u03ae \u03b9\u03c3\u03c7\u03cd \u03ba\u03b1\u03b9 \u03ad\u03bd\u03c4\u03b1\u03c3\u03b7 \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03b3\u03ba\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ad\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b9\u03b1\u03c4\u03c1\u03b9\u03ba\u03ae \u03c0\u03c1\u03ac\u03be\u03b7.<\/p>\n<p style=\"text-align: justify;\">\u0397 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03cc\u03bc\u03c9\u03c2 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03ad\u03bd\u03c4\u03b1\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03c3\u03c5\u03c7\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c4\u03b7\u03c2 \u03b1\u03ba\u03c4\u03af\u03bd\u03b1\u03c2 laser \u03c3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03bc\u03b1\u03c2 \u03ad\u03c6\u03c4\u03b1\u03c3\u03b5 \u03bd\u03b1 \u03c0\u03b1\u03c1\u03ac\u03b3\u03b5\u03b9 \u03bc\u03b9\u03b1 \u03b8\u03b5\u03c1\u03bc\u03b9\u03ba\u03ae \u03b1\u03ba\u03c4\u03b9\u03bd\u03bf\u03b2\u03bf\u03bb\u03af\u03b1 \u03bc\u03b5 \u03c4\u03b5\u03c1\u03ac\u03c3\u03c4\u03b9\u03b1 \u03b2\u03b9\u03bf\u03b4\u03b9\u03b1\u03b8\u03b5\u03c3\u03b9\u03bc\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf\u03c5\u03c2 \u03b9\u03c3\u03c4\u03bf\u03cd\u03c2 \u03b1\u03bb\u03bb\u03ac \u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03ba\u03b1\u03bb\u03b5\u03af \u03b8\u03b5\u03c1\u03bc\u03b9\u03ba\u03ae \u03b2\u03bb\u03ac\u03b2\u03b7 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03bd\u03b5\u03c0\u03ce\u03c2 \u03bd\u03b1 \u03b1\u03c0\u03b1\u03b9\u03c4\u03b5\u03af \u03b1\u03bd\u03b1\u03b9\u03c3\u03b8\u03b7\u03c3\u03af\u03b1 \u03ae \u03b1\u03bd\u03b1\u03bb\u03b3\u03b7\u03c3\u03af\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03c4\u03b7\u03c2.<\/p>\n<p style=\"text-align: justify;\">\u03a4\u03bf \u03b5\u03b9\u03b4\u03b9\u03ba\u03cc \u03b1\u03c5\u03c4\u03cc \u03bc\u03bf\u03bd\u03c4\u03ad\u03c1\u03bd\u03bf laser \u03bf\u03bd\u03bf\u03bc\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u00ab\u03ad\u03c1\u03b2\u03b9\u03bf\u00bb (erbium laser) \u03ba\u03b1\u03b9 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c4\u03bf \u03cc\u03c0\u03bb\u03bf \u03c0\u03bf\u03c5 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c4\u03bf\u03c5\u03bc\u03b5 \u03c3\u03c4\u03b7\u03bd \u03ba\u03bf\u03c3\u03bc\u03b7\u03c4\u03b9\u03ba\u03ae \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 \u03b3\u03b9\u03b1 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b1 \u03c0\u03b1\u03b8\u03ae\u03c3\u03b5\u03c9\u03bd \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03c3\u03b5 \u03b5\u03c0\u03af\u03c0\u03b5\u03b4\u03bf \u03b9\u03b1\u03c4\u03c1\u03b5\u03af\u03bf\u03c5 \u03c7\u03c9\u03c1\u03af\u03c2 \u03c0\u03cc\u03bd\u03bf \u03ba\u03b1\u03b9 \u03c3\u03c5\u03bd\u03b5\u03c0\u03ce\u03c2 \u03c7\u03c9\u03c1\u03af\u03c2 \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03b3\u03ba\u03b7 \u03bd\u03bf\u03c3\u03bf\u03ba\u03bf\u03bc\u03b5\u03af\u03bf\u03c5 \u03ae \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03b9\u03ce\u03bd \u03bc\u03b5 \u03c5\u03c8\u03b7\u03bb\u03cc \u03ba\u03cc\u03c3\u03c4\u03bf\u03c2.<\/p>\n<p style=\"text-align: justify;\">\u03a0\u03b9\u03bf \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03b1, \u03bf\u03b9 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03af\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03b1\u03ba\u03c1\u03ac\u03c4\u03b5\u03b9\u03b1\u03c2 \u03bf\u03cd\u03c1\u03c9\u03bd \u03c0\u03c1\u03bf\u03c3\u03c0\u03b1\u03b8\u03b5\u03af\u03b1\u03c2, \u03b7 \u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b7 \u03b1\u03c4\u03c1\u03bf\u03c6\u03af\u03b1 \u03b1\u03c5\u03c4\u03bf\u03cd \u03bc\u03b5 \u03c0\u03b1\u03c1\u03ac\u03bb\u03bb\u03b7\u03bb\u03b7 \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03bf\u03cd\u03bd \u03c4\u03bf \u03b5\u03c0\u03af\u03ba\u03b5\u03bd\u03c4\u03c1\u03bf \u03b1\u03c5\u03c4\u03ce\u03bd \u03c4\u03c9\u03bd \u03b1\u03bd\u03ce\u03b4\u03c5\u03bd\u03c9\u03bd \u03ba\u03b1\u03b9 \u03b5\u03c0\u03c9\u03c6\u03b5\u03bb\u03ce\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ce\u03bd \u03c0\u03bf\u03c5 \u03ad\u03c7\u03bf\u03c5\u03bd \u03c6\u03ad\u03c1\u03b5\u03b9 \u03b5\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd \u03b1\u03bd\u03c4\u03b9\u03bc\u03b5\u03c4\u03ce\u03c0\u03b9\u03c3\u03b7 \u03c4\u03c9\u03bd \u03b1\u03bd\u03c4\u03af\u03c3\u03c4\u03bf\u03b9\u03c7\u03c9\u03bd \u03b5\u03bd\u03bf\u03c7\u03bb\u03b7\u03c4\u03b9\u03ba\u03ce\u03bd \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03b9\u03b4\u03b9\u03b1\u03af\u03c4\u03b5\u03c1\u03b1 \u03c3\u03c5\u03c7\u03bd\u03ce\u03bd \u03c0\u03c1\u03bf\u03b2\u03bb\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03c4\u03b7\u03c2 \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b1\u03c2 \u03c3\u03b5 \u03bd\u03b5\u03b1\u03c1\u03ae \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c3\u03b5 \u03c0\u03b9\u03bf \u03c0\u03c1\u03bf\u03c7\u03c9\u03c1\u03b7\u03bc\u03ad\u03bd\u03b7 \u03b7\u03bb\u03b9\u03ba\u03af\u03b1.<\/p>\n<p style=\"text-align: justify;\">\u0397 \u03b5\u03c0\u03af\u03c4\u03b5\u03c5\u03be\u03b7 \u03c4\u03c9\u03bd \u03c3\u03c4\u03cc\u03c7\u03c9\u03bd \u03b1\u03c5\u03c4\u03ce\u03bd \u03c3\u03b5 \u03c0\u03b1\u03b8\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03c1\u03c7\u03b9\u03ba\u03ac \u03c6\u03b1\u03af\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03c4\u03b5\u03c1\u03cc\u03ba\u03bb\u03b7\u03c4\u03b5\u03c2, \u03b5\u03c0\u03b9\u03c4\u03c5\u03b3\u03c7\u03ac\u03bd\u03b5\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03af\u03b4\u03b9\u03bf \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc, \u03bc\u03b5 \u03c4\u03b7 \u03b4\u03c1\u03ac\u03c3\u03b7 \u03c4\u03bf\u03c5 laser \u03b4\u03b7\u03bb\u03b1\u03b4\u03ae, \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf\u03c5 \u03b1\u03c0\u03cc \u03c4\u03b1 \u03b5\u03bd \u03c4\u03c9 \u03b2\u03ac\u03b8\u03b5\u03b9 \u03c3\u03c4\u03c1\u03ce\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03b1 \u03b1\u03c0\u03cc \u03ba\u03cd\u03c4\u03c4\u03b1\u03c1\u03b1 \u03c0\u03bf\u03c5 \u03bb\u03ad\u03b3\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b9\u03bd\u03bf\u03b2\u03bb\u03ac\u03c3\u03c4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b2\u03c1\u03af\u03c3\u03ba\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03b2\u03ac\u03b8\u03bf\u03c2 1-2 cm \u03ba\u03ac\u03c4\u03c9 \u03b1\u03c0\u03cc \u03c4\u03bf \u03b2\u03bb\u03b5\u03bd\u03bd\u03bf\u03b3\u03cc\u03bd\u03bf \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5.<\/p>\n<p style=\"text-align: justify;\">\u0397 \u03b1\u03bd\u03c4\u03b1\u03c0\u03bf\u03b4\u03bf\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c4\u03c9\u03bd \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ce\u03bd \u03b9\u03c3\u03c4\u03ce\u03bd \u03c3\u03b5 \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf\u03c5 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03b1\u03c4\u03b1\u03c3\u03ba\u03b5\u03c5\u03b1\u03c3\u03c4\u03b9\u03ba\u03ac \u03c0\u03b5\u03bb\u03ce\u03c1\u03b9\u03b1 \u03b5\u03bd\u03ce \u03c4\u03b1\u03c5\u03c4\u03cc\u03c7\u03c1\u03bf\u03bd\u03b1 \u03ad\u03bd\u03b1 \u03bc\u03b5\u03b3\u03ac\u03bb\u03bf \u03c4\u03bc\u03ae\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ad\u03c7\u03b5\u03b9 \u03bc\u03b5\u03b9\u03c9\u03bc\u03ad\u03bd\u03bf\u03c5\u03c2 \u03c5\u03c0\u03bf\u03b4\u03bf\u03c7\u03b5\u03af\u03c2 \u03c0\u03cc\u03bd\u03bf\u03c5, \u03ba\u03b9 \u03ad\u03c4\u03c3\u03b9 \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c0\u03bf\u03b4\u03ad\u03ba\u03c4\u03b7\u03c2 \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03c0\u03bf\u03c3\u03ce\u03bd \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1\u03c2 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03ba\u03b1\u03bb\u03bf\u03cd\u03bd \u03bc\u03b5 \u03c4\u03b7 \u03c3\u03b5\u03b9\u03c1\u03ac \u03c4\u03bf\u03c5\u03c2 \u03c5\u03c0\u03b5\u03c1\u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf\u03c5 \u03c0\u03bf\u03c5 \u00bb \u03bd\u03b5\u03b1\u03c1\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u00bb \u03c4\u03b7\u03bd \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae.<\/p>\n<p style=\"text-align: justify;\">\u0395\u03be \u03bf\u03c5 \u03ba\u03b1\u03b9 \u03bf \u03cc\u03c1\u03bf\u03c2 LVR (laser vaginal rejuvenation \u2013 \u03ba\u03bf\u03bb\u03c0\u03b9\u03ba\u03ae \u03b1\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7 \u03bc\u03b5 laser) \u03c4\u03bf\u03c5 \u03bf\u03c0\u03bf\u03af\u03bf\u03c5 \u03b2\u03b1\u03c3\u03b9\u03ba\u03ac \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae \u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 erbium laser.<\/p>\n<p style=\"text-align: justify;\">\u0388\u03c4\u03c3\u03b9 \u03cc\u03c4\u03b1\u03bd \u03b7 \u03b1\u03ba\u03c4\u03af\u03bd\u03b1\u00a0 \u03b5\u03c3\u03c4\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae \u03b3\u03cd\u03c1\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03bf\u03c5\u03c1\u03ae\u03b8\u03c1\u03b1 \u03b7 \u03bc\u03b1\u03b6\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf\u03c5 \u03b3\u03cd\u03c1\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03bc\u03ad\u03c3\u03b7 \u03b1\u03bd\u03b1\u03c4\u03bf\u03bc\u03b9\u03ba\u03ac \u03bc\u03bf\u03af\u03c1\u03b1 \u03c4\u03b7\u03c2 \u03ad\u03c7\u03b5\u03b9 \u03c9\u03c2 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03c4\u03b7\u03bd \u03c6\u03c5\u03c3\u03b9\u03ba\u03ae \u03b5\u03bd\u03af\u03c3\u03c7\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae\u03c2, \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ce\u03bd\u03c4\u03b1\u03c2 \u03ad\u03bd\u03b1\u00a0 \u00ab\u03c3\u03ba\u03b1\u03bb\u03bf\u03c0\u03ac\u03c4\u03b9\u00bb \u03c0\u03bf\u03c5 \u03b5\u03bc\u03c0\u03bf\u03b4\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c0\u03c4\u03ce\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03c4\u03ac \u03c3\u03c5\u03bd\u03ad\u03c0\u03b5\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b1\u03c0\u03ce\u03bb\u03b5\u03b9\u03b1 \u03bf\u03cd\u03c1\u03c9\u03bd. \u0391\u03c5\u03c4\u03cc \u03b3\u03af\u03bd\u03b5\u03c4\u03b1\u03b9 \u03cc\u03c4\u03b1\u03bd \u03b1\u03c5\u03be\u03ac\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b7 \u03c0\u03af\u03b5\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae \u03c0\u03c7 \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf \u03b2\u03ae\u03c7\u03b1, \u03c4\u03bf \u03b3\u03ad\u03bb\u03b9\u03bf, \u03c4\u03b7 \u03b3\u03c5\u03bc\u03bd\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae \u03ae \u03c4\u03bf \u03c7\u03bf\u03c1\u03cc \u03ba\u03b1\u03b9 \u03b3\u03b9\u2019 \u03b1\u03c5\u03c4\u03cc \u03bf\u03bd\u03bf\u03bc\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03b1\u03ba\u03c1\u03ac\u03c4\u03b5\u03b9\u03b1 \u03c0\u03c1\u03bf\u03c3\u03c0\u03ac\u03b8\u03b5\u03b9\u03b1\u03c2.<\/p>\n<p style=\"text-align: justify;\">\u03a3\u03c4\u03b7\u03bd \u03c7\u03b1\u03bb\u03ac\u03c1\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03b1\u03bd\u03c4\u03af\u03b8\u03b5\u03c4\u03b1,\u00a0 \u03c0\u03bf\u03c5 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03b5\u03af\u03c4\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03b1\u03c0\u03cc \u03c4\u03bf\u03ba\u03b5\u03c4\u03cc \u03ba\u03b1\u03b9 \u03b5\u03b9\u03b4\u03b9\u03ba\u03ac \u03b5\u03c0\u03b9\u03c0\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03ba\u03b1\u03b9 \u03b2\u03ad\u03b2\u03b1\u03b9\u03b1 \u03b5\u03c0\u03b9\u03b4\u03b5\u03b9\u03bd\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c0\u03ac\u03c1\u03bf\u03b4\u03bf \u03c4\u03bf\u03c5 \u03c7\u03c1\u03cc\u03bd\u03bf\u03c5 \u03ae \u03c4\u03b7\u03bd \u03b1\u03cd\u03be\u03b7\u03c3\u03b7 \u03b2\u03ac\u03c1\u03bf\u03c5\u03c2, \u03b7 \u03b4\u03c1\u03ac\u03c3\u03b7 \u03c4\u03bf\u03c5 laser \u03b5\u03c6\u03b1\u03c1\u03bc\u03cc\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03ba\u03c5\u03ba\u03bb\u03b9\u03ba\u03bf\u03cd\u03c2 \u03b1\u03ba\u03c1\u03bf\u03b4\u03ad\u03ba\u03c4\u03b5\u03c2 (probes) \u03c0\u03bf\u03c5 \u03b1\u03ba\u03c4\u03b9\u03bd\u03bf\u03b2\u03bf\u03bb\u03bf\u03cd\u03bd \u03bf\u03bc\u03bf\u03b9\u03cc\u03bc\u03bf\u03c1\u03c6\u03b1 \u03cc\u03bb\u03b7 \u03c4\u03b7\u03bd \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ae \u03b5\u03c0\u03b9\u03c6\u03ac\u03bd\u03b5\u03b9\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03bc\u03b5 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c4\u03b7 \u03c3\u03cd\u03c3\u03c6\u03b9\u03be\u03b7 \u03cc\u03bb\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2.<\/p>\n<p style=\"text-align: justify;\">\u039c\u03c0\u03bf\u03c1\u03b5\u03af \u03ba\u03b1\u03bd\u03b5\u03af\u03c2 \u03bc\u03ac\u03bb\u03b9\u03c3\u03c4\u03b1 \u03bd\u03b1 \u03bc\u03b5\u03b3\u03b9\u03c3\u03c4\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03b9 \u03c4\u03bf \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03b1\u03bd\u03ac \u03b1\u03bd\u03b1\u03c4\u03bf\u03bc\u03b9\u03ba\u03ae \u03bc\u03bf\u03af\u03c1\u03b1 \u03c0\u03c7 \u03c0\u03c1\u03cc\u03c3\u03b8\u03b9\u03b1 \u03ae \u03bf\u03c0\u03af\u03c3\u03b8\u03b9\u03b1 \u03b1\u03bd\u03ac\u03bb\u03bf\u03b3\u03b1 \u03b1\u03bd \u03b7 \u03b3\u03c5\u03bd\u03b1\u03af\u03ba\u03b1 \u03c0\u03ac\u03c3\u03c7\u03b5\u03b9 \u03c0\u03b5\u03c1\u03b9\u03c3\u03c3\u03cc\u03c4\u03b5\u03c1\u03bf \u03b1\u03c0\u03cc \u03ba\u03c5\u03c3\u03c4\u03b5\u03bf\u03ba\u03ae\u03bb\u03b7 \u03ae \u03bf\u03c1\u03b8\u03bf\u03ba\u03ae\u03bb\u03b7.<\/p>\n<p style=\"text-align: justify;\">\u03a3\u03c4\u03b7\u03bd \u03b1\u03c4\u03c1\u03bf\u03c6\u03af\u03b1 \u03c4\u03bf\u03c5 \u03b2\u03bb\u03b5\u03bd\u03bd\u03bf\u03b3\u03cc\u03bd\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03bc\u03bc\u03b7\u03bd\u03cc\u03c0\u03b1\u03c5\u03c3\u03b7 (\u03b1\u03c6\u03bf\u03c1\u03ac 80% \u03c4\u03c9\u03bd \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03ce\u03bd ) \u03c0\u03bf\u03c5 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03be\u03b7\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1, \u03b4\u03c5\u03c3\u03ba\u03bf\u03bb\u03af\u03b1 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03c6\u03ae \u03ae \u03c0\u03cc\u03bd\u03bf \u03ba\u03b1\u03b9 \u03b1\u03c5\u03be\u03b7\u03bc\u03ad\u03bd\u03b7 \u03c0\u03b9\u03b8\u03b1\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03bb\u03bf\u03b9\u03bc\u03ce\u03be\u03b5\u03c9\u03bd \u03c4\u03b7\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae\u03c2, \u03c4\u03bf\u00a0 erbium laser, \u03b5\u03be\u03b1\u03b9\u03c4\u03af\u03b1\u03c2 \u03c4\u03b7\u03c2 \u03b5\u03b9\u03b4\u03b9\u03ba\u03ae\u03c2 \u03c4\u03bf\u03c5 \u03bc\u03bf\u03c1\u03c6\u03ae\u03c2, \u03b5\u03af\u03bd\u03b1\u03b9 \u03b5\u03c0\u03b1\u03bd\u03b1\u03c3\u03c4\u03b1\u03c4\u03b9\u03ba\u03cc, \u03ba\u03b1\u03b8\u03cc\u03c4\u03b9 \u03be\u03b5\u03c0\u03b5\u03c1\u03bd\u03ac \u03c4\u03b1 \u03b5\u03c0\u03b9\u03c6\u03b1\u03bd\u03b5\u03b9\u03b1\u03ba\u03ac \u03ba\u03b1\u03b9 \u03b5\u03c5\u03b1\u03af\u03c3\u03b8\u03b7\u03c4\u03b1 \u03c4\u03bf\u03b9\u03c7\u03ce\u03bc\u03b1\u03c4\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b1\u03c0\u03bb\u03ac \u00ab\u03b6\u03b5\u03c3\u03c4\u03b1\u03af\u03bd\u03b5\u03b9\u00bb \u03c4\u03b1 \u03b2\u03b1\u03b8\u03cd\u03c4\u03b5\u03c1\u03b1 \u03c3\u03c4\u03c1\u03ce\u03bc\u03b1\u03c4\u03b1, \u03c0\u03c1\u03bf\u03ba\u03b1\u03bb\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03ae \u03ba\u03bf\u03bb\u03bb\u03b1\u03b3\u03cc\u03bd\u03bf\u03c5 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03b9\u03bd\u03bf\u03b2\u03bb\u03ac\u03c3\u03c4\u03b5\u03c2, \u03c0\u03bf\u03c5 \u03bc\u03b5 \u03c4\u03b7 \u03c3\u03b5\u03b9\u03c1\u03ac \u03c4\u03bf\u03c5\u03c2 \u03b5\u03bd\u03c5\u03b4\u03b1\u03c4\u03ce\u03bd\u03bf\u03c5\u03bd \u03ba\u03b1\u03b9 \u03bd\u03b5\u03b1\u03c1\u03bf\u03c0\u03bf\u03b9\u03bf\u03cd\u03bd \u03c4\u03b7\u03bd \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae.<\/p>\n<p style=\"text-align: justify;\">\u0397 \u03b5\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03bb\u03bf\u03b9\u03c0\u03cc\u03bd \u03c4\u03c9\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ce\u03bd \u03c4\u03bf\u03c5 laser \u03bc\u03b5 \u03c4\u03b7 \u03bc\u03bf\u03c1\u03c6\u03ae erbium \u03ad\u03c7\u03b5\u03b9 \u03c9\u03c2 \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03c4\u03b7\u03bd \u03c5\u03b9\u03bf\u03b8\u03ad\u03c4\u03b7\u03c3\u03b7 \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ce\u03bd \u03b1\u03bd\u03b1\u03b6\u03c9\u03bf\u03b3\u03cc\u03bd\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b2\u03b5\u03bb\u03c4\u03af\u03c9\u03c3\u03b7\u03c2 \u03c4\u03b7\u03c2 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03cc\u03bb\u03c0\u03bf\u03c5 \u03bc\u03b5 \u03bc\u03b5\u03b8\u03cc\u03b4\u03bf\u03c5\u03c2 \u03b1\u03bd\u03ce\u03b4\u03c5\u03bd\u03b5\u03c2, \u03b1\u03bd\u03b1\u03af\u03bc\u03b1\u03ba\u03c4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03c4\u03c1\u03b1\u03c5\u03bc\u03b1\u03c4\u03b9\u03ba\u03ad\u03c2, \u03bc\u03b5 \u03c7\u03b1\u03bc\u03b7\u03bb\u03cc \u03ba\u03bf\u03c3\u03c4\u03bf\u03bb\u03cc\u03b3\u03b9\u03bf \u03ba\u03b1\u03b9 \u03c5\u03c8\u03b7\u03bb\u03ae \u03b1\u03c0\u03bf\u03b4\u03bf\u03c7\u03ae \u03b1\u03c0\u03cc \u03c4\u03b7 \u03c3\u03c5\u03bd\u03b5\u03af\u03b4\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03b3\u03c5\u03bd\u03b1\u03b9\u03ba\u03ce\u03bd.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u03a3\u03c4\u03b9\u03c2 \u03bc\u03ad\u03c1\u03b5\u03c2 \u03bc\u03b1\u03c2 \u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c4\u03b5\u0